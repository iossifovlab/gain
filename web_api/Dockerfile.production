# Production image for the web_api Django backend.
#
# Build from the repo root so the COPY paths into the build
# context resolve to dist/core/ and dist/web_api/ (where the
# root Jenkinsfile's parallel block writes the wheels):
#
#     docker build -f web_api/Dockerfile.production \
#         -t gain-web-api-prod:<tag> .
#
# The image installs only `gain-core` and
# `gain-web-api` — the three annotators are
# CLI/docker plugins and aren't needed at the Django runtime.
# Single foreground process: daphne on 9001.

# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim


# 1) Builder: install the wheels into an isolated venv at /opt/gpf.
FROM ${PYTHON_IMAGE} AS builder

RUN python -m venv /opt/gpf \
 && /opt/gpf/bin/pip install --no-cache-dir --upgrade pip

WORKDIR /wheels
COPY dist/core/gain_core-*.whl ./
COPY dist/web_api/gain_web_api-*.whl ./

RUN /opt/gpf/bin/pip install --no-cache-dir /wheels/*.whl


# 2) Runtime: minimal slim image, just libmagic1 + the venv.
FROM ${PYTHON_IMAGE} AS runtime

# python-magic needs libmagic at runtime; psycopg (3) needs
# libpq when installed without the [binary] extra (which is
# the case here since gain-core's pyproject pins plain
# `psycopg>=3.1.18`); curl is for the compose healthcheck
# (`curl http://localhost:9001/api/user_info`) — slim ships
# without any HTTP client.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        libmagic1 \
        libpq5 \
        curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/gpf /opt/gpf
ENV PATH=/opt/gpf/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=web_annotation.settings_daphne

# GRR config files (env var GRR_DEFINITION_FILE selects which one
# each compose file consumes): grr-definition-dir.yaml is the prod
# group (main GRR + grr_encode on CSHL's on-host GRR), and
# grr-definition.yaml is the single main-GRR repo the Jenkins e2e
# stack selects -- it now reads a node-local grr-sync directory tree
# (mounted read-only at /grr), the same single-repo shape it used
# pre-#271, instead of the interim http+cache GRR.
COPY web_api/scripts/grr-definition.yaml \
     web_api/scripts/grr-definition-dir.yaml /

EXPOSE 9001

# `--access-log /dev/null` discards daphne's access log rather than
# letting it default to stdout.  That log records the full request
# target, query string included, so every redemption of
# `/api/reset_password?code=…` or `/api/confirm_account?code=…` wrote a
# live single-use code into the container's stdout and from there into
# the host's docker `json-file` store (iossifovlab/gain#795; gain#754
# was the same leak in the frontend image's Apache log).  The record is
# dropped rather than redacted because the frontend Apache already logs
# every externally reachable request, with those queries redacted, so
# this one is a duplicate -- and daphne only accepts a redacting
# AccessLogGenerator through its server constructor, not from the CLI.
#
# Do NOT silence it with `-v 0` instead: verbosity drives the root
# logger too, so that would take the application's own logging down to
# WARN with it.  Verbosity stays at its default of 1.
ENTRYPOINT ["daphne", \
            "--bind", "0.0.0.0", \
            "--port", "9001", \
            "--proxy-headers", \
            "--http-timeout", "1200", \
            "--access-log", "/dev/null", \
            "web_annotation.asgi:application"]
