// Cron-scheduled orchestrator that rebuilds master from scratch
// and re-runs the integration jobs unconditionally. Catches
// dependency drift / silently-stale caches on quiet days.
//
// Five validation downstreams are exercised, then the validated
// image is deployed to staging:
//   - iossifovlab/gain/master        — full rebuild, lint+tests+
//                                      wheels+conda+prod images
//   - /gain-web-e2e                  — Playwright e2e against the
//                                      freshly built backend +
//                                      frontend
//   - /gain-vep-integration          — VEP integration tests
//                                      (otherwise gated on
//                                      vep_annotator/** changes)
//   - /gain-spliceai-integration     — spliceai integration tests
//                                      against the real hg38/GENCODE
//                                      resources
//   - /gain-python-matrix            — pytest matrix across
//                                      Python 3.12/3.13/3.14 for
//                                      core, demo_annotator,
//                                      vep_annotator, web_api
//   - /gain-staging-deploy           — deploys gainweb to pooh
//                                      (gain.seqpipe.org) pinned to
//                                      the master rebuild's
//                                      BUILD_NUMBER. Gated on all of
//                                      the above being green.
//
// The five validation stages are wrapped in `catchError` so a
// failure in one doesn't mask the others. By morning we want a
// single Zulip alert whose linked build surfaces every failing
// downstream, not just whichever broke first. The deploy stage uses
// a `when` gate instead: "deploy the nightly image" means *verified*
// master, not merely recent master — putting a known-bad build on
// staging is the one outcome this job exists to prevent.

// Zulip failure alert (seqpipe/infra#105). Verbatim copy of the block
// proven in #809 — do not re-derive it. This job already alerted only
// on failure; what changes is that the message now tags the channel and
// carries the failed-test count, so nightly breakage reads the same way
// as every other job's.
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far
            // as failing a test — a teardown / sidecar / agent problem
            // rather than a code break.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // Needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until then the alert fires without the
        // count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // builder = general build agents; deploy targets don't carry it
    agent { label 'builder' }

    options {
        // Generous: a cold master rebuild + e2e + VEP integration
        // can comfortably reach 90 minutes; 4 hours leaves headroom
        // for a slow/contended night without false-alarming.
        timeout(time: 4, unit: 'HOURS')
        // 40 keeps ~6 weeks of nightlies for trend analysis without
        // bloating the controller's disk.
        buildDiscarder(logRotator(numToKeepStr: '40'))
    }

    // tb-7e7: cron lives in jenkins-jobs/nightly.groovy (the Job
    // DSL), not here. A `triggers { cron(...) }` block in this
    // Jenkinsfile only registers AFTER the pipeline has run once,
    // and gain-seed re-applies the DSL on every master push —
    // wiping the registration before 02:00 UTC arrives. Putting the
    // cron in the DSL means each seed run re-asserts it explicitly.

    stages {
        stage('Rebuild master') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    script {
                        // Capture the downstream build's BUILD_NUMBER
                        // so `Deploy on pooh` can pin gainweb's image
                        // tag to exactly the image this nightly
                        // validated. Without the pin, a regular master
                        // push landing during the multi-hour nightly
                        // window would race — pooh would deploy
                        // whatever :latest points at when the deploy
                        // stage runs, NOT what we tested. The master
                        // build publishes :${BUILD_NUMBER} alongside
                        // :${GIT_SHORT} and :latest, and the root
                        // Jenkinsfile calls those three a *published*
                        // contract (the release pipeline already
                        // selects an upstream build by :${BUILD_NUMBER}
                        // the same way).
                        def rebuild = build(
                            job: 'iossifovlab/gain/master',
                            wait: true,
                            propagate: true,
                        )
                        env.MASTER_REBUILD_NUMBER =
                            rebuild.number.toString()
                        // ...and whether that build actually published
                        // an image at all. `Build & push prod images`
                        // is gated `not DOCS_ONLY`, so a master build
                        // whose whole changeset lives under docs/
                        // succeeds WITHOUT pushing :${BUILD_NUMBER} —
                        // pinning to it would then fail the deploy with
                        // an opaque "manifest unknown". The usual
                        // nightly case is an empty changeset, which the
                        // root Jenkinsfile deliberately scores as
                        // DOCS_ONLY=false, so this only bites when a
                        // docs-only commit lands in the window between
                        // the previous master build and this one.
                        // (gpf's `Fetch gain wheel` learned the same
                        // lesson the hard way against the same gate.)
                        //
                        // Reading it must never be what breaks the
                        // deploy, so this fails OPEN: anything other
                        // than a positive 'true' deploys, matching the
                        // root Jenkinsfile's own bias of short-circuiting
                        // only when it positively knows. Same defensive
                        // shape as zulipAlert() below.
                        try {
                            env.MASTER_REBUILD_DOCS_ONLY =
                                rebuild.buildVariables?.get('DOCS_ONLY') ?:
                                    'unknown'
                        } catch (ignored) {
                            env.MASTER_REBUILD_DOCS_ONLY = 'unknown'
                        }
                        echo "Master rebuild #${env.MASTER_REBUILD_NUMBER} " +
                             "(DOCS_ONLY=${env.MASTER_REBUILD_DOCS_ONLY})"
                    }
                }
            }
        }

        stage('Run gain-web-e2e') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gain-web-e2e',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        stage('Run gain-vep-integration') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gain-vep-integration',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        stage('Run gain-spliceai-integration') {
            // Unconditional nightly re-run: this is what catches drift in the
            // real hg38/GENCODE resources against the frozen #320 baseline (the
            // whole point of the #321 real tier), even when spliceai_annotator/
            // hasn't changed on master.
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gain-spliceai-integration',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        stage('Run gain-python-matrix') {
            steps {
                catchError(buildResult: 'FAILURE',
                           stageResult: 'FAILURE') {
                    build(
                        job: '/gain-python-matrix',
                        wait: true,
                        propagate: true,
                    )
                }
            }
        }

        stage('Deploy on pooh') {
            // Deploys the gainweb stack to pooh (gain.seqpipe.org),
            // pinned to the master rebuild's BUILD_NUMBER.
            //
            // The gate is the feature. If the e2e / vep / spliceai /
            // python-matrix stages tripped, this is skipped and
            // staging keeps yesterday's working build — `currentResult`
            // is already FAILURE/UNSTABLE by then, because every
            // catchError above sets it. UNSTABLE counts as "not green"
            // deliberately: lint/type gates mark the build UNSTABLE
            // rather than FAILURE, and an image that fails them is not
            // one to put on staging unattended overnight.
            //
            // NOT wrapped in catchError — if the deploy itself fails
            // after the gate passed, we want the nightly to go red and
            // alert. That is the whole reporting path this stage needs:
            // the existing post { failure { zulipSend(topic: 'nightly') } }
            // already carries it, which is why `wait: true,
            // propagate: true` is required here. The nightly's other
            // downstream triggers use the same shape; the `wait: false`
            // fire-and-forget pattern (and its branch-deletion caveat,
            // #489) belongs to the ROOT Jenkinsfile's branch-scoped
            // triggers, and applies to neither this stage nor the ones
            // above it. gain-staging-deploy takes no branch parameter
            // at all — its Job DSL pins the pipeline to gain-infra's
            // master — so no branch can be deleted out from under it.
            //
            // Unlike gpf-nightly's equivalent there is no wipe: this
            // deployment is never destroyed, so backend-migrate runs
            // against a long-lived database that accumulates state
            // across months of master builds. That is more
            // production-like, and it makes the deploy job's
            // pre-deploy pg_dump load-bearing rather than decorative —
            // it is the only way back from a bad migration.
            when {
                expression {
                    currentBuild.currentResult == 'SUCCESS' &&
                        env.MASTER_REBUILD_DOCS_ONLY != 'true'
                }
            }
            steps {
                build(
                    job: '/gain-staging-deploy',
                    wait: true,
                    propagate: true,
                    parameters: [
                        string(
                            name: 'IMAGE_TAG',
                            value: env.MASTER_REBUILD_NUMBER,
                        ),
                    ],
                )
            }
        }
    }

    post {
        failure {
            // Wrapped in an explicit node block: a pipeline-init
            // failure can tear down the outer agent before post
            // runs, leaving zulipSend without a FilePath context.
            // Same defensive pattern as Jenkinsfile.release's post
            // hooks.
            node('builder') {
                zulipSend(
                    topic: 'nightly',
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        // UNSTABLE now alerts too (seqpipe/infra#105): ruff/mypy/pylint
        // gate to UNSTABLE rather than FAILURE, so a failure-only rule
        // would let a lint regression sit silent overnight.
        unstable {
            node('builder') {
                zulipSend(
                    topic: 'nightly',
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
    }
}
