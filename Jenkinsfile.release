// Jenkins pipeline for the GAIn monorepo's tag-driven release.
//
// Phase 10 originally embedded this as a `stage('Release')` inside
// the root Jenkinsfile. It was extracted into this separate
// pipelineJob (`gain-release`) — see
// docs/2026-04-27-phase-10-release-pipeline.md "Addendum:
// extraction" for the rationale and decision D16.
//
// Triggered by:
//   - The root Jenkinsfile's `Dispatch release` stage when a CalVer
//     tag (^\d{4}\.\d+\.\d+$) lands on the multibranch (fire and
//     forget; the dispatcher does not block).
//   - Manual UI trigger (re-runs after transient publish failures).
//
// Inputs (mirrored in jenkins-jobs/release.groovy for the UI form):
//   - TAG_NAME        — the CalVer tag (e.g. 2026.4.27).
//   - UPSTREAM_PROJECT — multibranch path used to find the master
//                        CI build whose commit matches the tag
//                        (default 'iossifovlab/gain/master').
//   - SKIP_CONDA_GATE — operator override for the conda integration
//                        gate (#1431): a would-be abort becomes a
//                        warning, announced on Zulip. Default false.
//   - DRY_RUN         — run every pre-flight, build nothing past
//                        the conda-builder image, publish nothing.
//                        An already-published tag is reported, not
//                        rejected. Default false.
//
// Gates, in order: the master CI build for the tag's commit passed
// (`Pre-flight: master CI gate`), and the gain-conda-integration run
// for that commit — the one that installs the per-commit .conda from
// a file channel and runs core/tests/integration against it — is
// green (`Pre-flight: conda integration gate`, #1431). Both run
// before the conda-builder image is built, so an abort has built and
// uploaded nothing.
//
// Output: wheels published to nemo:/data/wheels/gain, conda
// packages to anaconda.org/iossifovlab, and Docker images to
// registry.seqpipe.org tagged :${TAG_NAME} + :stable. After the
// upload, `Post-publish: install smoke` installs gain-core==TAG_NAME
// from anaconda.org the way the docs say and walks its entry points
// (#1432) — advisory: a red is UNSTABLE plus a Zulip line, never a
// rollback.

import com.cloudbees.groovy.cps.NonCPS

// Look up the upstream multibranch build whose GIT_COMMIT matches
// the tagged commit. Wrapped in @NonCPS because WorkflowJob and
// WorkflowRun are not Serializable: if either reference is held in
// a CPS-scoped local across a CPS step (sh / echo / error / …),
// the program-state save throws NotSerializableException and the
// CPS thread dies (surfacing as a misleading
// "agent seems to be removed or offline" before the underlying
// NotSerializableException at end of pipeline).
//
// Therefore: do all Jenkins-API work here and return only
// primitives / Serializable values to the CPS world.
@NonCPS
def findUpstreamBuildForCommit(String project, String sha) {
    def job = jenkins.model.Jenkins.instance.getItemByFullName(project)
    if (job == null) {
        return [found: false, reason: 'missing']
    }
    for (b in job.getBuilds()) {
        def gitData = b.getAction(hudson.plugins.git.util.BuildData)
        if (gitData?.lastBuiltRevision?.sha1String == sha) {
            return [
                found:  true,
                number: b.number,
                result: b.result?.toString(),
            ]
        }
    }
    return [found: false, reason: 'no-match']
}

// The gain-conda-integration runs that tested `sha`, reduced to the
// two facts the gate decides on. Same @NonCPS rationale and the same
// already-approved API signatures as findUpstreamBuildForCommit —
// the job does a real `checkout` of the commit it tests, so its
// BuildData carries that commit whether the run was the per-push
// one, a manual re-run, or the nightly's pinned fan-out against
// master head (#1430).
//
// getBuilds() is newest first. A run whose result is still null is
// in progress. NOT_BUILT is "superseded" in that job — the commit
// vanished from the branch before checkout — so such a run tested
// nothing and is ignored.
//
// Returns [found: false] when the job is not on this controller,
// otherwise [found: true, latestCompleted: [number, result] or
// null, inProgress: [number] or null].
@NonCPS
def findCondaIntegrationRunsForCommit(String project, String sha) {
    def job = jenkins.model.Jenkins.instance.getItemByFullName(project)
    if (job == null) {
        return [found: false]
    }
    def latestCompleted = null
    def inProgress = null
    for (b in job.getBuilds()) {
        def gitData = b.getAction(hudson.plugins.git.util.BuildData)
        if (gitData?.lastBuiltRevision?.sha1String != sha) {
            continue
        }
        def result = b.result?.toString()
        if (result == null) {
            if (inProgress == null) {
                inProgress = [number: b.number]
            }
            continue
        }
        if (result == 'NOT_BUILT') {
            continue
        }
        if (latestCompleted == null) {
            latestCompleted = [number: b.number, result: result]
        }
    }
    return [
        found:           true,
        latestCompleted: latestCompleted,
        inProgress:      inProgress,
    ]
}

pipeline {
    // builder = general build agents; deploy targets don't carry it
    agent { label 'builder' }

    parameters {
        string(
            name: 'TAG_NAME',
            defaultValue: '',
            description: 'CalVer tag to release (e.g. 2026.4.27). ' +
                'Must match ^\\d{4}\\.\\d+\\.\\d+$. Pre-release ' +
                'suffixes are deferred to V2.',
        )
        string(
            name: 'UPSTREAM_PROJECT',
            defaultValue: 'iossifovlab/gain/master',
            description: 'Multibranch path used to locate the ' +
                'master CI build whose GIT_COMMIT matches the ' +
                'tagged commit. Override only if the multibranch ' +
                'folder layout has changed.',
        )
        booleanParam(
            name: 'SKIP_CONDA_GATE',
            defaultValue: false,
            description: 'Release even though the gain-conda-' +
                'integration run for the tagged commit is red or ' +
                'missing. For a known ecosystem-drift red only: the ' +
                'gate still reports what it found, the skip is ' +
                'logged here and announced in the Zulip release ' +
                'notification.',
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Run every pre-flight (tag checkout, master ' +
                'CI gate, conda integration gate, tag freshness, ' +
                'credentials) and stop: nothing is built past the ' +
                'conda-builder image and nothing is published. An ' +
                'already-published tag is reported, not rejected.',
        )
    }

    options {
        timeout(time: 1, unit: 'HOURS')
        // 40 keeps several months of release history while still
        // letting Jenkins reclaim disk on a job that runs once
        // per CalVer tag.
        buildDiscarder(logRotator(numToKeepStr: '40'))
        // Concurrency: D13 (publish lock) is the only required
        // serialization point. Pre-publish work uses separate
        // workspaces (Jenkins @2/@3 suffixes) and BUILD_NUMBER, so
        // overlapping releases are safe up to the lock. We
        // deliberately do NOT disableConcurrentBuilds().
        skipDefaultCheckout(true)
    }

    environment {
        REGISTRY        = 'registry.seqpipe.org'
        BACKEND_REPO    = "${env.REGISTRY}/gain-web-api"
        FRONTEND_REPO   = "${env.REGISTRY}/gain-web-ui"
        REGISTRY_USER   = credentials('user.registry.seqpipe.org')
        REGISTRY_PASS   = credentials('passwd.registry.seqpipe.org')
        ANACONDA_TOKEN  = credentials('anaconda-token-iossifovlab')
        WHEELS_HOST     = 'wheels.seqpipe.org'
        // Stated explicitly so we don't rely on each Jenkins
        // agent's ~/.ssh/config to map wheels.seqpipe.org to the
        // right account. Without this, a build that landed on an
        // agent whose ssh config didn't set `User seqpipe` would
        // ssh in as the local jenkins user, hit a directory it
        // can't write, and fail mkstemp during rsync.
        WHEELS_USER     = 'seqpipe'
        WHEELS_PATH     = '/data/wheels/gain'
        ANACONDA_USER   = 'iossifovlab'
        // `gain-conda-builder-release`, not `gain-conda-builder-ci`: the
        // latter is the root Jenkinsfile's conda-builder image. This job
        // deliberately does not disableConcurrentBuilds() and is fired
        // from that same pipeline, so sharing the name meant two jobs on
        // independent build counters building and `docker rmi`-ing one
        // tag (#478).
        CONDA_BUILDER   = "gain-conda-builder-release:${env.BUILD_NUMBER}"
        // The job the conda integration gate consults and, when no
        // run exists for the tag's commit, triggers. Declared at the
        // Jenkins root by core/jenkins-jobs/conda_integration.groovy.
        CONDA_INTEGRATION_JOB = 'gain-conda-integration'
        // Lift params.TAG_NAME into env.TAG_NAME so the existing
        // shell heredocs (lifted from the embedded Release stage)
        // can keep using ${TAG_NAME} unchanged.
        TAG_NAME        = "${params.TAG_NAME}"
    }

    stages {
        stage('Validate + checkout tag') {
            steps {
                script {
                    if (!params.TAG_NAME) {
                        error('TAG_NAME parameter is required.')
                    }
                    // Defense-in-depth: the dispatcher in the root
                    // Jenkinsfile already filters CalVer tags, but
                    // gain-release is also manually triggerable
                    // and a typo in the UI should fail cleanly
                    // here, not deep in the pipeline.
                    if (!(params.TAG_NAME ==~ /^\d{4}\.\d+\.\d+$/)) {
                        error(
                            "TAG_NAME '${params.TAG_NAME}' does " +
                            'not match the CalVer pattern ' +
                            '^\\d{4}\\.\\d+\\.\\d+$. Pre-release ' +
                            'suffixes are deferred to V2.'
                        )
                    }
                }
                // skipDefaultCheckout(true) means we own the
                // checkout. shallow:false / noTags:false are
                // load-bearing for hatch-vcs's `git describe
                // --tags` to resolve the clean tag version
                // without a .dev suffix.
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${params.TAG_NAME}"]],
                    extensions: [
                        [$class: 'CloneOption',
                         shallow: false,
                         noTags: false,
                         depth: 0],
                    ],
                    userRemoteConfigs: [[
                        url: 'https://github.com/iossifovlab/gain.git',
                    ]],
                ])
                sh '''
                    set -e
                    described=$(git describe --tags --always --dirty)
                    echo "git describe: $described"
                    test "$described" = "${TAG_NAME}"
                '''
            }
        }

        stage('Pre-flight: master CI gate') {
            // Find the master multibranch build whose GIT_COMMIT
            // matches the tagged commit and assert tests passed.
            // SUCCESS and UNSTABLE are both accepted: lint and
            // type-check findings (ruff / mypy / pylint) mark the
            // upstream build UNSTABLE but do not gate the release,
            // mirroring the policy in Jenkinsfile:9-13. FAILURE
            // (pytest non-zero, or the build broke before pytest
            // ran) blocks the release.
            //
            // Stash the matched build number for the copyArtifacts
            // call below. D8 — see Phase 10 design doc.
            //
            // Uses Jenkins core APIs that require in-process
            // script approval the first time gain-release runs
            // (admin → "Manage Jenkins" → "In-process Script
            // Approval").
            steps {
                script {
                    def upstreamProject = params.UPSTREAM_PROJECT
                    def tagSha = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true,
                    ).trim()
                    def info = findUpstreamBuildForCommit(
                        upstreamProject, tagSha)
                    if (!info.found && info.reason == 'missing') {
                        error(
                            "Upstream project '${upstreamProject}' " +
                            'not found. Override UPSTREAM_PROJECT ' +
                            'if the multibranch path has changed.'
                        )
                    }
                    if (!info.found) {
                        error(
                            "No ${upstreamProject} build found for " +
                            "commit ${tagSha}. Tag a commit that " +
                            'has been merged to master and built ' +
                            'green.'
                        )
                    }
                    if (!(info.result in ['SUCCESS', 'UNSTABLE'])) {
                        error(
                            "Upstream master build " +
                            "#${info.number} for commit " +
                            "${tagSha} did not pass tests " +
                            "(${info.result}). Refusing to release."
                        )
                    }
                    env.UPSTREAM_BUILD_NUMBER = info.number.toString()
                    env.GIT_COMMIT = tagSha
                    echo(
                        "Upstream master build: #${info.number} " +
                        "(${info.result}) for commit ${tagSha}"
                    )
                }
            }
        }

        stage('Pre-flight: conda integration gate') {
            // #1431: a package that failed its own integration run
            // must not reach anaconda.org under a release tag. The
            // most recent completed gain-conda-integration run for
            // the tagged commit must be SUCCESS — a pytest failure
            // exits that job's test container non-zero, so a red
            // suite is FAILURE there, and UNSTABLE/ABORTED are not
            // a pass either. "Most recent completed" is deliberate:
            // a manual green re-run clears a flaky red without the
            // override, a genuinely red package still blocks.
            //
            // No completed run but one in progress: abort naming
            // it rather than wait or trigger a duplicate; the
            // release is re-runnable. No run at all — never
            // triggered (a docs-only tip) or discarded by the job's
            // retention — trigger one now against the same master
            // build the gate above matched and wait for it: the
            // run takes minutes and the release has an hour.
            //
            // SKIP_CONDA_GATE turns each abort into a warning and
            // skips the trigger (the release must never wait on a
            // run it is going to ignore). Whatever happened is
            // recorded in CONDA_GATE_NOTE for the build description
            // and the Zulip notification.
            steps {
                script {
                    String job = env.CONDA_INTEGRATION_JOB
                    String tagSha = env.GIT_COMMIT
                    String jobUrl = "${env.JENKINS_URL}job/${job}/"
                    // null = pass; otherwise the reason the gate
                    // would abort.
                    String verdict = null
                    String satisfiedBy = null
                    def info = findCondaIntegrationRunsForCommit(
                        job, tagSha)
                    if (!info.found) {
                        verdict = "job '${job}' is not on this " +
                            'controller (has gain-seed run?)'
                    } else if (info.latestCompleted != null) {
                        def r = info.latestCompleted
                        String run = "#${r.number} (${r.result}) " +
                            "${jobUrl}${r.number}/"
                        if (r.result == 'SUCCESS') {
                            satisfiedBy = run
                        } else {
                            verdict = 'the most recent completed ' +
                                "${job} run for commit ${tagSha} " +
                                "is ${run}"
                        }
                    } else if (info.inProgress != null) {
                        int n = info.inProgress.number
                        verdict = "${job} #${n} for commit " +
                            "${tagSha} is still running " +
                            "(${jobUrl}${n}/); re-run gain-release " +
                            "for TAG_NAME=${params.TAG_NAME} once " +
                            'it finishes'
                    } else if (params.SKIP_CONDA_GATE) {
                        verdict = "no ${job} run exists for commit " +
                            "${tagSha}, and none was triggered " +
                            'because SKIP_CONDA_GATE is set'
                    } else {
                        echo(
                            "No ${job} run exists for commit " +
                            "${tagSha} (never triggered, or " +
                            'discarded by retention). Triggering ' +
                            'one against master build ' +
                            "#${env.UPSTREAM_BUILD_NUMBER} and " +
                            'waiting for it.'
                        )
                        // Same identity pair the root Jenkinsfile
                        // passes; PYTHON_VERSION empty = unpinned,
                        // what the per-push run tests.
                        def triggered = build(
                            job: "/${job}",
                            parameters: [
                                string(
                                    name: 'BRANCH_NAME',
                                    value: 'master',
                                ),
                                string(
                                    name: 'COMMIT_SHA',
                                    value: tagSha,
                                ),
                                string(
                                    name: 'UPSTREAM_PROJECT',
                                    value: params.UPSTREAM_PROJECT,
                                ),
                                string(
                                    name: 'UPSTREAM_BUILD',
                                    value: env.UPSTREAM_BUILD_NUMBER,
                                ),
                                string(
                                    name: 'PYTHON_VERSION',
                                    value: '',
                                ),
                            ],
                            wait: true,
                            propagate: false,
                        )
                        String run = "#${triggered.number} " +
                            "(${triggered.result}) " +
                            "${triggered.absoluteUrl}"
                        if (triggered.result == 'SUCCESS') {
                            satisfiedBy = "${run}, triggered by " +
                                'this release'
                        } else {
                            verdict = "${job} ${run}, triggered by " +
                                'this release for commit ' +
                                "${tagSha}, did not pass"
                        }
                    }

                    String note
                    if (verdict == null) {
                        note = "conda gate satisfied by ${job} " +
                            "${satisfiedBy}"
                        if (params.SKIP_CONDA_GATE) {
                            note += ' (SKIP_CONDA_GATE was set but ' +
                                'not needed)'
                        }
                        echo(note)
                    } else if (params.SKIP_CONDA_GATE) {
                        note = 'conda gate SKIPPED by operator ' +
                            "(SKIP_CONDA_GATE) over: ${verdict}"
                        echo(
                            '*** WARNING: releasing without a ' +
                            "green ${job} run. ${note} ***"
                        )
                    } else {
                        error(
                            "Conda integration gate: ${verdict}. " +
                            'Refusing to release. Re-run ' +
                            "${job} for this commit and then " +
                            'gain-release, or set SKIP_CONDA_GATE ' +
                            'for a known ecosystem-drift red.'
                        )
                    }
                    env.CONDA_GATE_NOTE = note
                    currentBuild.description =
                        (params.DRY_RUN ? 'DRY RUN · ' : '') +
                        "master #${env.UPSTREAM_BUILD_NUMBER} · " +
                        note
                }
            }
        }

        stage('Setup') {
            // Workspace prep + conda-builder image. Deferred until
            // both CI gates pass so doomed releases don't pay the
            // docker-build cost. (In the embedded Release stage
            // these prerequisites came from earlier multibranch CI
            // stages for free.)
            steps {
                sh '''
                    rm -rf reports dist conda
                    mkdir -p reports dist conda
                    docker build -f conda-builder/Dockerfile \
                        -t "${CONDA_BUILDER}" conda-builder
                '''
            }
        }

        stage('Pre-flight: tag freshness') {
            // Reject tag mutation: if any destination already has
            // an artefact for ${TAG_NAME}, abort. D14.
            //
            // A dry run reports the finding instead of aborting on
            // it. A fresh tag fires the real release on its own, so
            // every dry run is against a tag that is already out,
            // and "already published" is the expected answer there,
            // not a defect in the tag — the point of the dry run is
            // the gates before this one and the credentials after.
            //
            // The probe script exits non-zero for exactly one
            // reason, an artefact already published: network and
            // index failures are treated as "not there yet" inside
            // it, so returnStatus loses nothing.
            steps {
                script {
                    int published = sh(
                        returnStatus: true,
                        script: '''
                            # HEAD on the wheels index — 200 means
                            # already published. Anything else (404,
                            # 5xx, network) is treated as "not there
                            # yet, proceed" so a flaky index doesn't
                            # block releases.
                            code=$(curl -sS -o /dev/null \
                                -w '%{http_code}' \
                                "https://${WHEELS_HOST}/gain/gain_core-${TAG_NAME}-py3-none-any.whl")
                            echo "Wheel index probe: HTTP $code"
                            if [ "$code" = "200" ]; then
                                echo "gain-core ${TAG_NAME} is already" \
                                     "at https://${WHEELS_HOST}/gain/"
                                exit 1
                            fi

                            # Anaconda check: exit 0 means the
                            # package exists; non-zero (1, 2,
                            # network) is treated as "not there
                            # yet". Output discarded to keep the
                            # build log readable.
                            if docker run --rm "${CONDA_BUILDER}" \
                                anaconda show \
                                    "${ANACONDA_USER}/gain-core/${TAG_NAME}" \
                                    >/dev/null 2>&1; then
                                echo "gain-core ${TAG_NAME} is already" \
                                     "on Anaconda.org/${ANACONDA_USER}"
                                exit 1
                            fi
                        ''',
                    )
                    if (published != 0) {
                        if (params.DRY_RUN) {
                            env.TAG_FRESHNESS_NOTE =
                                "${params.TAG_NAME} is already " +
                                'published; a real release would ' +
                                'be rejected here as tag mutation'
                            echo(
                                'DRY RUN: ' + env.TAG_FRESHNESS_NOTE +
                                '. Continuing.'
                            )
                        } else {
                            error(
                                "gain-core ${params.TAG_NAME} is " +
                                'already published (see above). ' +
                                'Tag mutation is rejected. Cut a ' +
                                'new tag instead.'
                            )
                        }
                    }
                }
            }
        }

        stage('Pre-flight: credentials') {
            // Touch each destination before any state mutates.
            // Catches expired tokens, network failures, missing
            // ssh keys before the publish phase begins. D10.
            steps {
                sshagent(credentials: ['wheels-seqpipe-ssh-key']) {
                    sh '''
                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "${WHEELS_USER}@${WHEELS_HOST}" true
                    '''
                }
                sh '''
                    docker run --rm \
                        -e ANACONDA_TOKEN \
                        "${CONDA_BUILDER}" \
                        anaconda --token "$ANACONDA_TOKEN" whoami
                '''
                sh '''
                    # #10: validate registry creds in an isolated
                    # per-build DOCKER_CONFIG. The old bare `docker
                    # logout "$REGISTRY"` here mutated the shared
                    # ~/.docker/config.json and could wipe a
                    # concurrent build's push auth (cf. gpf #5742 /
                    # iossifovlab/gpf#856) — this preflight is a prime
                    # trigger. Removing the private config dir IS the
                    # logout, and touches no shared state.
                    export DOCKER_CONFIG="$WORKSPACE/.docker-cfg-$BUILD_NUMBER-preflight"
                    mkdir -p "$DOCKER_CONFIG"
                    trap 'rm -rf "$DOCKER_CONFIG"' EXIT
                    printf '%s' "$REGISTRY_PASS" | docker login \
                        -u "$REGISTRY_USER" \
                        --password-stdin "$REGISTRY"
                '''
            }
        }

        stage('Fetch base-images.lock') {
            // DRY_RUN stops at the pre-flights.
            when { expression { !params.DRY_RUN } }
            // Pull the digest lockfile from the master build
            // identified above. fingerprintArtifacts:true pairs
            // with the master archiveArtifacts' fingerprint:true
            // so the file is locatable even if the build record
            // itself rotated.
            steps {
                copyArtifacts(
                    projectName: params.UPSTREAM_PROJECT,
                    selector: specific(env.UPSTREAM_BUILD_NUMBER),
                    filter: 'dist/base-images.lock',
                    fingerprintArtifacts: true,
                )
                sh 'cat dist/base-images.lock'
            }
        }

        stage('Build wheels + sdists') {
            // DRY_RUN stops at the pre-flights.
            when { expression { !params.DRY_RUN } }
            // hatch-vcs derives the embedded version from `git
            // describe --tags`; at a tagged commit this resolves
            // to the clean ${TAG_NAME} with no .dev suffix.
            // Verified immediately after build — a shallow clone
            // would yield a dev version and we abort before
            // publishing.
            //
            // Built inside ${CONDA_BUILDER} because uv is not
            // installed on the Jenkins agents; the conda-builder
            // image carries uv alongside rattler-build and
            // anaconda-client.
            steps {
                sh '''
                    mkdir -p dist/core dist/web_api \
                        dist/demo_annotator \
                        dist/vep_annotator \
                        dist/spliceai_annotator
                    DOCKER_USER="$(id -u):$(id -g)"
                    docker run --rm \
                        --user "$DOCKER_USER" \
                        -e HOME=/tmp \
                        -v $PWD:/workspace \
                        -w /workspace \
                        "${CONDA_BUILDER}" \
                        bash -c '
                            set -e
                            for pkg in core web_api \
                                       demo_annotator \
                                       vep_annotator \
                                       spliceai_annotator; do
                                distpkg="gain-${pkg//_/-}"
                                uv build --package "$distpkg" \
                                    --out-dir "dist/$pkg"
                            done
                        '

                    bad=0
                    for whl in dist/*/*.whl; do
                        case "$whl" in
                            *"-${TAG_NAME}-py3-none-any.whl") ;;
                            *)
                                echo "$whl does not embed" \
                                     "clean ${TAG_NAME}" >&2
                                bad=1
                                ;;
                        esac
                    done
                    if [ "$bad" != 0 ]; then
                        echo "hatch-vcs did not resolve to" \
                             "${TAG_NAME} — likely a shallow" \
                             "clone. Aborting." >&2
                        exit 1
                    fi
                '''
            }
        }

        stage('Build conda packages') {
            // DRY_RUN stops at the pre-flights.
            when { expression { !params.DRY_RUN } }
            // Reuses the rattler-build flow from the (now-deleted)
            // root multibranch Conda packages stage, with
            // VCS_VERSION pulled from the freshly built wheel
            // filenames so the conda versions match.
            steps {
                sh '''
                    VCS_VERSION=$(ls dist/core/*.whl \
                        | head -1 \
                        | sed 's#.*gain_core-##' \
                        | sed 's#-py3-none-any.whl$##')
                    echo "VCS_VERSION=$VCS_VERSION"

                    mkdir -p dist/conda
                    DOCKER_USER="$(id -u):$(id -g)"
                    # The core output dir is a channel so the annotator
                    # recipes' test envs can resolve gain-core -- see the
                    # root Jenkinsfile's Conda packages stage (#1433).
                    for proj in core demo_annotator \
                                vep_annotator \
                                spliceai_annotator; do
                        mkdir -p conda/$proj
                        docker run --rm \
                            --user "$DOCKER_USER" \
                            -e HOME=/tmp \
                            -v $PWD:/workspace \
                            -w /workspace \
                            -e VCS_VERSION="$VCS_VERSION" \
                            "${CONDA_BUILDER}" \
                            rattler-build build \
                                --recipe $proj/conda-recipe/recipe.yaml \
                                --output-dir conda/$proj \
                                -c file:///workspace/conda/core \
                                -c conda-forge -c bioconda
                        cp conda/$proj/noarch/*.conda dist/conda/
                    done
                '''
            }
        }

        stage('Build prod Docker (digest-pinned)') {
            // DRY_RUN stops at the pre-flights.
            when { expression { !params.DRY_RUN } }
            // Same Dockerfiles the master build uses, but with
            // PYTHON_IMAGE / NODE_IMAGE / HTTPD_IMAGE pinned to
            // the digests captured by the upstream master build.
            // Tagged directly as :${TAG_NAME}; :stable is applied
            // at push time.
            steps {
                sh '''
                    set -a
                    . dist/base-images.lock
                    set +a
                    echo "PYTHON_IMAGE=${PYTHON_IMAGE}"
                    echo "NODE_IMAGE=${NODE_IMAGE}"
                    echo "HTTPD_IMAGE=${HTTPD_IMAGE}"

                    docker build \
                        -f web_api/Dockerfile.production \
                        --build-arg PYTHON_IMAGE="${PYTHON_IMAGE}" \
                        -t "${BACKEND_REPO}:${TAG_NAME}" .

                    docker build \
                        -f web_ui/Dockerfile.production \
                        --build-arg NODE_IMAGE="${NODE_IMAGE}" \
                        --build-arg HTTPD_IMAGE="${HTTPD_IMAGE}" \
                        --build-arg BACKEND_IMAGE="${BACKEND_REPO}:${TAG_NAME}" \
                        -t "${FRONTEND_REPO}:${TAG_NAME}" .
                '''
            }
        }

        stage('Publish') {
            // DRY_RUN stops at the pre-flights. beforeOptions:
            // otherwise the lock below is taken before `when`
            // is evaluated, and a dry run would queue behind a
            // real publish for nothing.
            when {
                beforeOptions true
                expression { !params.DRY_RUN }
            }
            // Serialize across overlapping releases (D13). The
            // lock collides only with another gain-release
            // currently in Publish; pre-publish stages of other
            // gain-release builds are unaffected.
            options {
                lock(resource: 'gain-release-publish')
            }
            steps {
                // 1) Wheels + sdists → wheels.seqpipe.org
                sshagent(credentials: ['wheels-seqpipe-ssh-key']) {
                    sh '''
                        files=$(ls \
                            dist/core/gain_core-*.whl \
                            dist/core/gain_core-*.tar.gz \
                            dist/web_api/gain_web_api-*.whl \
                            dist/web_api/gain_web_api-*.tar.gz \
                            dist/demo_annotator/gain_demo_annotator-*.whl \
                            dist/demo_annotator/gain_demo_annotator-*.tar.gz \
                            dist/vep_annotator/gain_vep_annotator-*.whl \
                            dist/vep_annotator/gain_vep_annotator-*.tar.gz \
                            dist/spliceai_annotator/gain_spliceai_annotator-*.whl \
                            dist/spliceai_annotator/gain_spliceai_annotator-*.tar.gz)
                        # Deliberate word-split on $files.
                        rsync -av \
                            -e "ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new" \
                            $files \
                            "${WHEELS_USER}@${WHEELS_HOST}:${WHEELS_PATH}/"
                        # Regenerate the simple/ index in a
                        # throwaway python:3.12-slim container on
                        # the wheels host: pip install pip2pi at
                        # run time, then dir2pi against the mounted
                        # wheels dir. (pip2pi ships dir2pi/pip2pi/
                        # pip2tgz — there's no `pip-index` binary.)
                        # Wheels host needs only docker; no Python
                        # tooling installed there.
                        #
                        # setuptools is pinned <80 because libpip2pi
                        # imports pkg_resources, which setuptools 80
                        # removed; an unpinned install on Python 3.12
                        # picks up setuptools 82+ and breaks dir2pi
                        # with ModuleNotFoundError: pkg_resources.
                        #
                        # The heredoc lets ${WHEELS_PATH} expand
                        # on the agent while \\$(id -u)/\\$(id -g)
                        # remain literal so the remote shell
                        # evaluates them — index files end up
                        # owned by the SSH user, not
                        # root-in-container. HOME=/tmp gives pip
                        # --user a writable home for the random
                        # UID we're running as.
                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "${WHEELS_USER}@${WHEELS_HOST}" \
                            bash <<EOF
set -e
docker run --rm \\
    --user "\\$(id -u):\\$(id -g)" \\
    -e HOME=/tmp \\
    -v "${WHEELS_PATH}":/work \\
    -w /work \\
    python:3.12-slim \\
    sh -c 'pip install --quiet --user "setuptools<80" pip2pi && /tmp/.local/bin/dir2pi .'
EOF
                    '''
                }

                // 2) Conda → Anaconda.org/iossifovlab.
                //
                // Uploaded with rattler-build's own `upload
                // anaconda` subcommand instead of `anaconda-client`
                // because the latter (via conda-package-handling
                // 2.4.0) failed to extract metadata from the
                // .conda files produced by rattler-build 0.63.1
                // ("Trouble reading metadata"). Using the same
                // binary that built the package avoids that
                // parser-version mismatch.
                //
                // --force replaces on conflict, giving us the same
                // idempotent re-run semantics that anaconda-client
                // had with --skip-existing (rattler-build doesn't
                // ship a skip-existing flag, but our builds are
                // deterministic so overwriting with the same
                // content is harmless). D10.
                //
                // Wrapped in `sh -c '…'` so /dist/conda/*.conda
                // glob-expands inside the container, where the
                // path actually exists. Without the wrapper the
                // agent's shell expanded the glob against its own
                // root (no /dist/conda there), found no match, and
                // passed the literal pattern through. ANACONDA_TOKEN
                // + ANACONDA_USER come in via -e so the inner
                // single-quoted script can reference them without
                // agent-side interpolation.
                //
                // --user runs the container as the Jenkins user
                // (matches the build stage). Without it the
                // container default is mambauser, which has no
                // permission to read the .conda files owned by
                // the Jenkins user — produces an opaque
                // "io error occurred: Permission denied". HOME=/tmp
                // gives the random UID a writable home for any
                // rattler-build cache lookups.
                sh '''
                    DOCKER_USER="$(id -u):$(id -g)"
                    docker run --rm \
                        --user "$DOCKER_USER" \
                        -e HOME=/tmp \
                        -e ANACONDA_TOKEN \
                        -e ANACONDA_USER \
                        -v "$PWD/dist/conda:/dist/conda:ro" \
                        "${CONDA_BUILDER}" \
                        sh -c 'rattler-build upload anaconda --owner "$ANACONDA_USER" --api-key "$ANACONDA_TOKEN" --force /dist/conda/*.conda'
                '''

                // 3) Docker → registry.seqpipe.org with
                // :${TAG_NAME} immutable + :stable moving.
                // Re-pushing same digest is a registry no-op
                // (D10).
                sh '''
                    # #10: per-build DOCKER_CONFIG so a concurrent
                    # job's `docker logout` can't drop our auth
                    # between pushes (auth instance of the tb-w8d /
                    # build #137 shared-daemon race; cf. iossifovlab/
                    # gpf#856).
                    export DOCKER_CONFIG="$WORKSPACE/.docker-cfg-$BUILD_NUMBER-push"
                    mkdir -p "$DOCKER_CONFIG"
                    printf '%s' "$REGISTRY_PASS" | docker login \
                        -u "$REGISTRY_USER" \
                        --password-stdin "$REGISTRY"
                    trap 'docker logout "$REGISTRY" || true; rm -rf "$DOCKER_CONFIG"' EXIT

                    for repo in "$BACKEND_REPO" "$FRONTEND_REPO"; do
                        docker tag "$repo:$TAG_NAME" \
                                   "$repo:stable"
                        docker push "$repo:$TAG_NAME"
                        docker push "$repo:stable"
                    done
                '''
            }
        }

        stage('Post-publish: install smoke') {
            // #1432: the only check that exercises the real channel.
            // Do what the getting-started docs tell a user to do —
            // a fresh env from `-c conda-forge -c bioconda
            // -c iossifovlab`, pinned to this tag — then run the
            // recipe's console-script / entry-point walk against
            // what got installed. Proves the upload landed, the
            // version resolves, and the live solve with iossifovlab
            // present still works.
            //
            // Advisory: the upload has happened and is not rolled
            // back. A red marks the build UNSTABLE (never FAILURE),
            // fails this stage by name, and posts one line to the
            // releases topic saying which of two things happened —
            // the version never resolved, or it installed and the
            // walk failed. anaconda.org's repodata lags an upload by
            // minutes, so the solve is retried for up to 10 min
            // before that first verdict is given.
            //
            // The walk is core/conda-recipe/tests/entry_point_walk.py,
            // the same file rattler-build embeds in the package's
            // tests; it is mounted alone at /smoke so nothing but the
            // installed package is on the walk's sys.path. Exit codes
            // from the driver: 2 = never resolved, 3 = walk failed.
            when { expression { !params.DRY_RUN } }
            steps {
                script {
                    int rc = sh(
                        returnStatus: true,
                        script: '''
                            DOCKER_USER="$(id -u):$(id -g)"
                            docker run --rm -i \
                                --user "$DOCKER_USER" \
                                -e HOME=/tmp \
                                -e TAG_NAME \
                                -v "$PWD/core/conda-recipe/tests:/smoke:ro" \
                                -w /tmp \
                                "${CONDA_BUILDER}" \
                                bash -s <<'EOF'
set -u
# Package cache under /tmp: we run as the Jenkins uid, which cannot
# write the image's /opt/conda/pkgs. Set here, after the image
# entrypoint has activated base from the original root prefix.
export MAMBA_ROOT_PREFIX=/tmp/mamba
prefix=/tmp/smoke-env
spec="gain-core==${TAG_NAME}"
deadline=$(( $(date +%s) + 600 ))
attempt=0
while :; do
    attempt=$((attempt + 1))
    rm -rf "$prefix"
    echo "attempt $attempt: micromamba create -p $prefix -c conda-forge -c bioconda -c iossifovlab $spec"
    if micromamba create -y -p "$prefix" \
            -c conda-forge -c bioconda -c iossifovlab \
            "$spec" > /tmp/solve.log 2>&1; then
        break
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
        cat /tmp/solve.log
        echo "SMOKE: $spec did not resolve from anaconda.org/iossifovlab" \
             "within 10 min ($attempt attempts); last solve output above"
        exit 2
    fi
    echo "  solve failed; repodata may still lag the upload. Retrying in 30s."
    sleep 30
done
micromamba list -p "$prefix" | grep -i -E '^\\s*(gain-core|python)\\s'
"$prefix/bin/python" /smoke/entry_point_walk.py gain-core || {
    echo "SMOKE: $spec installed, but the entry-point walk failed"
    exit 3
}
EOF
                        ''',
                    )
                    String note
                    if (rc == 0) {
                        note = 'install smoke: ok'
                    } else if (rc == 2) {
                        note = 'install smoke: UNSTABLE — ' +
                            "gain-core==${env.TAG_NAME} did not " +
                            'resolve from anaconda.org/iossifovlab ' +
                            'within 10 min'
                    } else {
                        note = 'install smoke: UNSTABLE — installed, ' +
                            'but the entry-point walk failed ' +
                            "(exit ${rc})"
                    }
                    env.INSTALL_SMOKE_NOTE = note
                    if (rc != 0) {
                        zulipSend(
                            topic: 'releases',
                            message:
                                "Release ${env.TAG_NAME}: stage " +
                                "'Post-publish: install smoke' " +
                                "failed — ${note}. The upload is " +
                                'complete and untouched. ' +
                                "${env.BUILD_URL}",
                        )
                        // Build UNSTABLE, this stage FAILURE, the
                        // pipeline carries on to Notify.
                        catchError(
                            buildResult: 'UNSTABLE',
                            stageResult: 'FAILURE',
                        ) {
                            error(note)
                        }
                    }
                }
            }
        }

        stage('Notify') {
            // A dry run says so and claims no release. A real
            // release's line carries the post-publish smoke result,
            // and an operator override of the conda gate is announced
            // on the same line as the release it let through, so the
            // audit trail is the releases topic itself.
            steps {
                script {
                    String message
                    if (params.DRY_RUN) {
                        message = "DRY RUN of release ${env.TAG_NAME} " +
                            'passed every pre-flight; nothing was ' +
                            "built or published — ${env.BUILD_URL}"
                        if (env.TAG_FRESHNESS_NOTE) {
                            message += " (${env.TAG_FRESHNESS_NOTE})"
                        }
                    } else {
                        message = "Released ${env.TAG_NAME} — wheels: " +
                            "https://${env.WHEELS_HOST}/gain/, " +
                            "conda: https://anaconda.org/" +
                                "${env.ANACONDA_USER}, " +
                            "docker: ${env.BACKEND_REPO}:" +
                                "${env.TAG_NAME} + " +
                            "${env.FRONTEND_REPO}:" +
                                "${env.TAG_NAME} " +
                            "(also tagged :stable) — " +
                            "${env.INSTALL_SMOKE_NOTE}"
                    }
                    if (params.SKIP_CONDA_GATE) {
                        message += " — ⚠️ ${env.CONDA_GATE_NOTE}"
                    }
                    zulipSend(topic: 'releases', message: message)
                }
            }
        }
    }

    post {
        failure {
            // The dispatcher fires us with wait:false,propagate:false,
            // so failures here never bubble up to the multibranch
            // tag-build. Announce on Zulip so the developer who
            // pushed the tag finds out without hunting for a build
            // URL. A dry run is named as one, so a deliberate red
            // probe of the gates is not read as a broken release.
            //
            // Wrapped in an explicit node block: a failure during
            // pipeline init (e.g., a missing credential in the
            // `environment {}` block) tears down the agent before
            // post runs, leaving zulipSend without a FilePath
            // context. Allocating our own node guarantees Zulip
            // fires whether the failure was mid-stage (where the
            // outer agent is still alive) or pre-stage (where it
            // isn't).
            node('builder') {
                zulipSend(
                    topic: 'releases',
                    message:
                        (params.DRY_RUN ? 'DRY RUN of release '
                                        : 'Release ') +
                        "${params.TAG_NAME} FAILED — " +
                        "${env.BUILD_URL}",
                )
            }
        }
        cleanup {
            // Strip ephemeral images this build produced. All
            // `|| true` so a missing image (e.g. early failure
            // before the docker build ran) doesn't fail the
            // cleanup step.
            //
            // Same node-wrap rationale as `failure` above. ${...:-}
            // shell defaults guard against pipeline-init failures
            // that abort before the `environment {}` block sets
            // BACKEND_REPO/FRONTEND_REPO/CONDA_BUILDER/TAG_NAME —
            // empty values turn the rmi into a harmless no-op.
            node('builder') {
                sh '''
                    docker rmi "${CONDA_BUILDER:-}" 2>/dev/null || true
                    for repo in "${BACKEND_REPO:-}" "${FRONTEND_REPO:-}"; do
                        [ -z "$repo" ] && continue
                        for tag in "${TAG_NAME:-}" stable; do
                            [ -z "$tag" ] && continue
                            docker rmi "$repo:$tag" 2>/dev/null || true
                        done
                    done
                '''
            }
        }
    }
}
