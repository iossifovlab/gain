// Dedicated Jenkins pipeline for the gain-core integration test suite
// (core/tests/integration). Builds the regular gain-core CI image and runs
// pytest against the effect-annotation integration tests, which resolve the
// hg19 genome + refGene gene models from the grr-seqpipe http GRR
// (https://grr-seqpipe.seqpipe.org).
//
// Expected Jenkins job setup:
//   - Script path: core/Jenkinsfile.integration
//   - Job DSL: core/jenkins-jobs/integration.groovy (pipelineJob
//     'gain-core-integration'), seeded by gain-seed.
//   - Triggered downstream from iossifovlab/gain/<branch> on every branch
//     (see the 'Trigger core integration' stage in the root Jenkinsfile),
//     and safe to run manually.

pipeline {
    // Pinned to `pooh`: the persistent GRR cache under ${HOME}/grr_seqpipe_cache
    // is maintained on that agent and reused across builds (the ~787MB genome
    // is downloaded once, then range-read from the local copy).
    agent { label 'pooh' }

    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // The shared cache dir fills lazily on the first (cold) build; the
        // suite runs single-threaded so concurrent workers never race to
        // download the same resource. Serialise builds on the agent too.
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'BRANCH_NAME',
            defaultValue: 'master',
            description: 'Branch the upstream gain build was triggered from. ' +
                'The pipeline checks out this branch unless COMMIT_SHA is set.',
        )
        string(
            name: 'COMMIT_SHA',
            defaultValue: '',
            description: 'Specific commit SHA to test (takes precedence over ' +
                'BRANCH_NAME). Empty = use BRANCH_NAME HEAD.',
        )
    }

    environment {
        // Named once because the `Checkout` stage both clones from it and
        // `git ls-remote`s it to tell a superseded commit from a genuine
        // checkout failure.
        GAIN_REPO_URL = 'https://github.com/iossifovlab/gain.git'

        IMAGE_TAG = "gain-core-integration-ci:${env.BUILD_NUMBER}"
        // Persistent across builds. Anchored to the agent home (on pooh,
        // /var/lib/jenkins -> ZFS via the home symlink) rather than a
        // hardcoded /data mount. The same absolute path is bind-mounted into
        // the test container and passed as GRR_INTEGRATION_CACHE_DIR so the
        // grr_seqpipe fixture wraps the http repo in a cache at this location.
        GRR_CACHE_DIR = "${env.HOME}/grr_seqpipe_cache"
    }

    stages {
        stage('Start') {
            steps {
                script {
                    // Replace the default '#42' with '#42 <branch>' (plus
                    // '@<short-sha>' on manual COMMIT_SHA pins) so the build
                    // list makes it obvious which branch a build is for. Set
                    // before any stage that can fail so the label is visible
                    // even on early aborts.
                    String label = params.BRANCH_NAME
                    if (params.COMMIT_SHA?.trim()) {
                        label += " @ ${params.COMMIT_SHA.take(7)}"
                    }
                    currentBuild.displayName = \
                        "#${env.BUILD_NUMBER} ${label}"
                    zulipSend(
                        message: "Started build #${env.BUILD_NUMBER} [${label}] of project ${env.JOB_NAME} (${env.BUILD_URL})",
                        topic: "${env.JOB_NAME}",
                    )
                }
            }
        }

        // Ahead of `Checkout` on purpose (gain#489). The agent workspace is
        // reused between builds, so the previous build's pytest.xml is still
        // sitting in `reports/integration` when this build starts. The `junit`
        // step in `post { always }` runs whatever it finds there even when
        // every stage was skipped — build #346 executed nothing after its
        // checkout failed and still advertised "173 tests, 0 failures", which
        // were byte-for-byte #345's numbers. A build that ran no tests must
        // report no tests, so the stale report is cleared before anything that
        // can fail. `web_e2e/Jenkinsfile.e2e` already orders its own
        // `Prepare workspace` this way; this is the same ordering, not a new
        // idea.
        stage('Prepare workspace') {
            steps {
                sh 'rm -rf reports && mkdir -p reports/integration'
            }
        }

        // The job definition (this Jenkinsfile) is loaded from master by the
        // Job DSL, but the source under test is the branch/commit the parent
        // build triggered from.
        //
        // This stage is the port of the gain#414 fix that `web_e2e` already
        // carries; gain#489 is that same defect surviving in the sibling job
        // that was not touched. Two distinct things used to fail it red:
        //
        //   1. `depth: 1`. A shallow fetch of `+refs/heads/*` lands only
        //      branch TIPS, so an explicit COMMIT_SHA resolved only for as
        //      long as it still WAS some branch's tip — an ordinary
        //      fast-forward push between the upstream trigger and this stage
        //      broke a build whose SHA was still perfectly reachable. It also
        //      degraded the shared workspace repo (cloned with full history by
        //      the declarative `Checkout SCM`) into a shallow one. Hence: no
        //      shallow clone here.
        //
        //   2. A force-push past COMMIT_SHA orphans it — unreachable from
        //      every ref, therefore unfetchable at ANY depth. This job is
        //      triggered from the parent's last stages, ~9-25 minutes after
        //      that build began, so on a branch being rebased through review
        //      that is the normal case rather than a tight race.
        //
        // A build whose commit no longer exists has not failed, it has been
        // SUPERSEDED: report NOT_BUILT and skip the suite rather than raise a
        // red Zulip alert for a run that never had a chance. The build
        // triggered by the new tip carries the verdict.
        //
        // Only a MOVED BRANCH justifies that. If the tip is still our SHA then
        // the checkout failed for some other reason (network, disk,
        // credentials) and the build must stay red — so rethrow.
        stage('Checkout') {
            steps {
                script {
                    String sha = params.COMMIT_SHA?.trim()
                    String ref = sha ?: params.BRANCH_NAME
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: ref]],
                            userRemoteConfigs: [[
                                url: env.GAIN_REPO_URL,
                            ]],
                            extensions: [[$class: 'CloneOption',
                                          shallow: false,
                                          noTags: true]],
                        ])
                    } catch (Exception err) {
                        // Read the tip through the shell env rather than
                        // Groovy interpolation, so a branch name never lands
                        // inside the command string.
                        String tip = sh(
                            script: 'git ls-remote "$GAIN_REPO_URL" ' +
                                    '"refs/heads/$BRANCH_NAME" ' +
                                    '| cut -f1',
                            returnStdout: true,
                        ).trim()
                        if (!sha || tip == sha) {
                            throw err
                        }
                        env.SUPERSEDED = 'true'
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName += ' (superseded)'
                        echo(
                            "COMMIT_SHA ${sha} is no longer on " +
                            "${params.BRANCH_NAME} (tip is now " +
                            "${tip ?: 'nothing — branch is gone'}). " +
                            'This build was superseded by a newer push ' +
                            'before it could start; marking it NOT_BUILT ' +
                            'and skipping the suite.'
                        )
                    }
                }
            }
        }

        stage('Build image') {
            // Every stage from here on is guarded the same way: on a
            // superseded COMMIT_SHA (see `Checkout`) there are no sources to
            // test, and the build is already NOT_BUILT.
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                // Build from the repo root so the workspace manifests and
                // uv.lock are in the build context (see core/Dockerfile).
                // --extra ann-data-10x: the integration tier is the only
                // place scanpy is installed. gain reads the 10x triple
                // itself now (ADR 0014), so tests/integration holds that
                // reader against the one it replaced -- every parameter,
                // and all three layouts (v2 genes.tsv, v3 features.tsv.gz,
                // v3 uncompressed). A failure there means upstream moved
                // and someone has to decide; it does NOT mean gain
                // regressed, which the small tier owns. The main CI image
                // builds without the arg and stays scanpy-free.
                sh 'docker build -f core/Dockerfile \
                        --build-arg UV_SYNC_EXTRAS="--extra ann-data-10x" \
                        -t ${IMAGE_TAG} .'
            }
        }

        stage('Integration tests') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh '''
                    mkdir -p "${GRR_CACHE_DIR}"
                    # The image WORKDIR is /workspace/core, so tests/integration
                    # resolves and the checked-in grr-seqpipe definition is found
                    # relative to the test file.
                    #
                    # CURL_CA_BUNDLE: pysam/libcurl needs a CA bundle it can find
                    # to open the genome over https; point it at the image's
                    # system bundle.
                    #
                    # Single-threaded (no -n): the first cold build populates the
                    # shared cache, and parallel workers would race to write the
                    # same resource.
                    docker run --rm \
                        -v "${GRR_CACHE_DIR}:${GRR_CACHE_DIR}" \
                        -v "$PWD/reports/integration:/reports" \
                        -e GRR_INTEGRATION_CACHE_DIR="${GRR_CACHE_DIR}" \
                        -e CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
                        ${IMAGE_TAG} \
                        sh -c '
                            set +e
                            pytest -v tests/integration \
                                --junitxml=/reports/pytest.xml
                            pytest_exit=$?
                            chmod -R a+rw /reports
                            exit $pytest_exit
                        '
                '''
            }
        }
    }

    post {
        always {
            script {
                try {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'reports/integration/*.xml',
                    )
                    archiveArtifacts(
                        artifacts: 'reports/integration/*.xml',
                        allowEmptyArchive: true,
                        fingerprint: false,
                    )
                } finally {
                    zulipNotification(topic: "${env.JOB_NAME}")
                }
            }
        }
        cleanup {
            sh 'docker rmi ${IMAGE_TAG} 2>/dev/null || true'
        }
    }
}
