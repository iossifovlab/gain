// Dedicated Jenkins pipeline that runs the gain-core integration test
// suite (core/tests/integration) against the CONDA PACKAGE the upstream
// build archived, installed the way a user would (#1429). Sibling of
// core/Jenkinsfile.integration, which runs the same tier from a `uv sync`
// of the source tree: a red here that is green there means packaging or
// channel resolution, not code.
//
// The artefact (dist/conda/gain-core-*.conda) is copied from the upstream
// build, indexed into a local file channel and solved with
// `--override-channels --strict-channel-priority` over
// `file:///channel, conda-forge, bioconda` -- no iossifovlab channel, so a
// published gain-core can never shadow the one under test (gpf#916). The
// test bed is a copy of core/tests + core/pytest.ini only, and the run
// asserts `gain` imports from the conda prefix at the artefact's version
// before pytest starts. See core/conda-integration/.
//
// Advisory per push: a red posts the Zulip alert and blocks nothing
// there, and PYTHON_VERSION is left empty so the solve tests what a
// user's `mamba create` resolves to today. Jenkinsfile.nightly runs this
// job three more times against the master rebuild, pinned to each Python
// of its `pinnedPythons` list (#1430) -- a red there gates the nightly's
// staging deploy like every other nightly downstream. The release gate
// (#1431) is a separate slice.
//
// Expected Jenkins job setup:
//   - Script path: core/Jenkinsfile.conda-integration
//   - Job DSL: core/jenkins-jobs/conda_integration.groovy (pipelineJob
//     'gain-conda-integration'), seeded by gain-seed.
//   - Triggered downstream from iossifovlab/gain/<branch> on every branch
//     (see the 'Trigger conda integration' stage in the root Jenkinsfile)
//     and from Jenkinsfile.nightly's pinned fan-out; safe to run manually
//     (defaults: master, artefact from the last successful build of
//     iossifovlab/gain/<BRANCH_NAME>, unpinned).

// Zulip failure alert (seqpipe/infra#105). Builds that pass say nothing.
//
// `build-status` used to receive a "Started build" message *and* a result
// message for every build of every job — 827 messages in 48h, of which 10 were
// failures — which made it unreadable, so nobody read it. Only FAILURE and
// UNSTABLE alert now, and they tag the channel so the alert actually pushes.
//
// UNSTABLE is included deliberately: ruff/mypy/pylint gate to UNSTABLE rather
// than FAILURE, so a failure-only rule would let a lint regression sit silent
// until the 09:00 digest (seqpipe/infra#110).
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far as
            // failing a test — a teardown / sidecar / agent problem rather
            // than a code break. Saying which is what decides "re-run" vs
            // "investigate" without opening Jenkins.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // getAction() needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until that lands the alert still fires, just
        // without the count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // `builder` is the positive label carried by the build agents — the
    // hosts that also hold the node-local grr-sync trees (seqpipe/infra#71),
    // so the suite reads the grr-seqpipe copy off local disk wherever it
    // lands; the `GRR pre-flight` stage asserts that before the docker
    // build. (The label replaces the older `!dory` exclusion idiom.) Until
    // #799 this job was pinned to `pooh`, whose persistent http-GRR cache
    // was the only warm copy of the ~787MB genome — a single point of
    // failure the node-local trees remove.
    agent { label 'builder' }

    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // The implicit `Declarative: Checkout SCM` clone is redundant here --
        // the explicit `Checkout` stage checks out the exact branch/commit
        // under test into the same workspace -- and it is also the clone that
        // killed build #775: on an agent this job has never run on, it is a
        // FULL cold clone of gain (~500MB) running under the git plugin's
        // default 10-minute timeout, which a ~200KiB/s GitHub link cannot
        // meet (git-remote-https died of signal 15 at 26%). Skip it; the
        // explicit stage carries its own generous clone timeout instead.
        // Same option as Jenkinsfile.release.
        skipDefaultCheckout()
    }

    parameters {
        string(
            name: 'BRANCH_NAME',
            defaultValue: 'master',
            description: 'Branch the upstream gain build was triggered from. ' +
                'The pipeline checks out this branch unless COMMIT_SHA is set.',
        )
        string(
            name: 'COMMIT_SHA',
            defaultValue: '',
            description: 'Specific commit SHA to test (takes precedence over ' +
                'BRANCH_NAME). Empty = use BRANCH_NAME HEAD.',
        )
        // Same upstream-identity pair as gain-web-e2e: the package under
        // test is the .conda archived by THIS build of the root pipeline,
        // not whatever is published.
        string(
            name: 'UPSTREAM_PROJECT',
            defaultValue: '',
            description: 'Upstream Jenkins project name ' +
                '(e.g. iossifovlab/gain/master) the gain-core .conda is ' +
                'copied from. Empty = iossifovlab/gain/<BRANCH_NAME>.',
        )
        string(
            name: 'UPSTREAM_BUILD',
            defaultValue: '',
            description: 'Upstream build number to copy the .conda from. ' +
                'Empty = the last successful build of UPSTREAM_PROJECT. ' +
                'On a manual run make sure that build is of the commit ' +
                'under test, or the suite tests one tree against ' +
                'another\'s package.',
        )
        string(
            name: 'PYTHON_VERSION',
            defaultValue: '',
            description: 'Pin the solve to this Python (e.g. 3.12). Empty ' +
                '= unpinned, what a user\'s `mamba create` sees; the ' +
                'nightly matrix (#1430) sets it.',
        )
    }

    environment {
        // Named once because the `Checkout` stage both clones from it and
        // `git ls-remote`s it to tell a superseded commit from a genuine
        // checkout failure.
        GAIN_REPO_URL = 'https://github.com/iossifovlab/gain.git'

        IMAGE_TAG = "gain-conda-integration-ci:${env.BUILD_NUMBER}"

        // GRR_ROOT is the node-local grr-sync root holding the stable
        // per-repo symlink <root>/grr_seqpipe, published by grr-sync (atomic
        // mode, iossifovlab/grr-sync#20) and provisioned per agent by
        // seqpipe/infra#71 -- where it is NOT a uniform path: /tank/grr on
        // pooh (a dedicated ZFS dataset), /data/grr on the LVM agents. This
        // job's label is `builder`, so it can land on any of them — dory
        // included: the `!dory` exclusion this comment used to name was
        // retired in the builder-label sweep (#802), and reading it as still
        // in force is what made gain#921 look impossible. Resolve
        // per-node: honour an explicit GRR_ROOT from the agent's node
        // environment if set, else auto-detect the first candidate that
        // exists. The `GRR pre-flight` stage then asserts grr_seqpipe
        // resolves under it with a .CONTENTS manifest, so a wrong/empty root
        // fails loudly before the docker build. Same resolution as
        // web_e2e/Jenkinsfile.e2e, which reads the sibling `grr` tree.
        GRR_ROOT = sh(
            script: '''
                if [ -n "${GRR_ROOT:-}" ]; then
                    printf '%s' "$GRR_ROOT"; exit 0
                fi
                for d in /tank/grr /data/grr; do
                    [ -d "$d" ] && { printf '%s' "$d"; exit 0; }
                done
                # Nothing found: emit a non-resolving sentinel so the
                # pre-flight fails with a clear "GRR not synced on this
                # node yet" rather than an empty value.
                printf '%s' "/grr-not-provisioned"
            ''',
            returnStdout: true,
        ).trim()
    }

    stages {
        stage('Start') {
            steps {
                script {
                    // Replace the default '#42' with '#42 <branch>' (plus
                    // '@<short-sha>' on manual COMMIT_SHA pins, plus
                    // 'py3.13' when the solve is pinned) so the build list
                    // makes it obvious which branch -- and, for the
                    // nightly's fan-out (#1430), which Python -- a build is
                    // for; the job's own Zulip alert carries the same name.
                    // Set before any stage that can fail so the label is
                    // visible even on early aborts.
                    String label = params.BRANCH_NAME
                    if (params.COMMIT_SHA?.trim()) {
                        label += " @ ${params.COMMIT_SHA.take(7)}"
                    }
                    if (params.PYTHON_VERSION?.trim()) {
                        label += " py${params.PYTHON_VERSION.trim()}"
                    }
                    currentBuild.displayName = \
                        "#${env.BUILD_NUMBER} ${label}"
                }
            }
        }

        // Ahead of `Checkout` on purpose (gain#489). The agent workspace is
        // reused between builds, so the previous build's pytest.xml is still
        // sitting in `reports/conda-integration` when this build starts,
        // and the previous build's .conda in `dist/conda`. The `junit` step
        // in `post { always }` runs whatever it finds there even when every
        // stage was skipped -- the sibling job's build #346 executed nothing
        // after its checkout failed and still advertised "173 tests, 0
        // failures", byte-for-byte #345's numbers. A build that ran no tests
        // must report no tests, and a build that copied no artefact must
        // not find last build's, so both are cleared before anything that
        // can fail. Same ordering as core/Jenkinsfile.integration and
        // web_e2e/Jenkinsfile.e2e.
        //
        // Staying ahead of `Checkout` is load-bearing for a second reason:
        // on a workspace with no git repo the git plugin wipes the whole
        // workspace itself, as the agent user, and one root-owned leftover
        // makes that throw `Failed to delete workspace`. Clearing such a
        // leftover here is what keeps the build alive to reach it.
        //
        // Creating the reports directory, though, has to happen AFTER
        // `Checkout` -- that same wipe deletes anything made before it, which
        // is how gain#917 broke the sibling job. It lives next to its one
        // consumer in `Conda integration tests` instead.
        stage('Wipe workspace') {
            steps {
                // `rm -rf` as the agent user is enough right up until a
                // previous build leaves something root-owned, and a bind
                // mount manufactures exactly that: dockerd creates a MISSING
                // bind source as root:root, so the first build in a cold
                // workspace hands `reports/` to root and every later build
                // in that workspace dies here with `Permission denied`
                // until an operator cleans the host (gain#921).
                //
                // The container removes it as root, the way
                // `web_e2e/Jenkinsfile.e2e` does. It is a FALLBACK rather
                // than the default deliberately: pulling `alpine` would put
                // Docker Hub in the path of a stage that otherwise touches
                // no network, and a Hub timeout would then fail a build
                // whose tests are fine. So the happy path stays local, and
                // root is only involved when there is genuinely root-owned
                // state to remove. `rm -rf` on an absent path succeeds, so
                // a cold workspace does not reach for it.
                sh '''
                    rm -rf reports dist \
                        || docker run --rm -v "$PWD:/wd" -w /wd alpine \
                               rm -rf reports dist
                '''
            }
        }

        // The job definition (this Jenkinsfile) is loaded from master by the
        // Job DSL, but the source under test is the branch/commit the parent
        // build triggered from.
        //
        // This stage is the port of the gain#414 fix that `web_e2e` already
        // carries; gain#489 is that same defect surviving in the sibling job
        // that was not touched. Two distinct things used to fail it red:
        //
        //   1. `depth: 1`. A shallow fetch of `+refs/heads/*` lands only
        //      branch TIPS, so an explicit COMMIT_SHA resolved only for as
        //      long as it still WAS some branch's tip — an ordinary
        //      fast-forward push between the upstream trigger and this stage
        //      broke a build whose SHA was still perfectly reachable. It also
        //      degraded the shared workspace repo (cloned with full history by
        //      the declarative `Checkout SCM`) into a shallow one. Hence: no
        //      shallow clone here.
        //
        //   2. A force-push past COMMIT_SHA orphans it — unreachable from
        //      every ref, therefore unfetchable at ANY depth. This job is
        //      triggered from the parent's last stages, ~9-25 minutes after
        //      that build began, so on a branch being rebased through review
        //      that is the normal case rather than a tight race.
        //
        // A build whose commit no longer exists has not failed, it has been
        // SUPERSEDED: report NOT_BUILT and skip the suite rather than raise a
        // red Zulip alert for a run that never had a chance. The build
        // triggered by the new tip carries the verdict.
        //
        // Only a MOVED BRANCH justifies that. If the tip is still our SHA then
        // the checkout failed for some other reason (network, disk,
        // credentials) and the build must stay red — so rethrow.
        stage('Checkout') {
            steps {
                script {
                    String sha = params.COMMIT_SHA?.trim()
                    String ref = sha ?: params.BRANCH_NAME
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: ref]],
                            userRemoteConfigs: [[
                                url: env.GAIN_REPO_URL,
                            ]],
                            // timeout (minutes) covers the one cold FULL
                            // clone a fresh agent pays now that the job is
                            // unpinned (#799): ~500MB at the ~200KiB/s the
                            // agents see from GitHub needs ~40min, and the
                            // plugin default of 10 kills it (build #775).
                            // Warm builds fetch incrementally and never go
                            // near it.
                            extensions: [[$class: 'CloneOption',
                                          shallow: false,
                                          noTags: true,
                                          timeout: 60]],
                        ])
                    } catch (Exception err) {
                        // Read the tip through the shell env rather than
                        // Groovy interpolation, so a branch name never lands
                        // inside the command string.
                        String tip = sh(
                            script: 'git ls-remote "$GAIN_REPO_URL" ' +
                                    '"refs/heads/$BRANCH_NAME" ' +
                                    '| cut -f1',
                            returnStdout: true,
                        ).trim()
                        if (!sha || tip == sha) {
                            throw err
                        }
                        env.SUPERSEDED = 'true'
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName += ' (superseded)'
                        echo(
                            "COMMIT_SHA ${sha} is no longer on " +
                            "${params.BRANCH_NAME} (tip is now " +
                            "${tip ?: 'nothing — branch is gone'}). " +
                            'This build was superseded by a newer push ' +
                            'before it could start; marking it NOT_BUILT ' +
                            'and skipping the suite.'
                        )
                    }
                }
            }
        }

        // Fail fast if grr-sync has not published the node-local grr_seqpipe
        // tree on this agent yet (seqpipe/infra#71). A dangling symlink or
        // absent tree would otherwise mount as an empty dir and fail deep in
        // the suite with a confusing `FileNotFoundError: .CONTENTS.json`.
        // Same check (and manifest-name tolerance) as the `Compose env`
        // pre-flight in web_e2e/Jenkinsfile.e2e.
        stage('GRR pre-flight') {
            // Every stage from here on is guarded the same way: on a
            // superseded COMMIT_SHA (see `Checkout`) there are no sources to
            // test, and the build is already NOT_BUILT.
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh '''
                    set -eu

                    tree="$GRR_ROOT/grr_seqpipe"
                    resolved="$(readlink -e "$tree" || true)"
                    if [ -z "$resolved" ]; then
                        echo "GRR not synced on this node yet: grr_seqpipe" >&2
                        echo "  ($tree does not resolve -- grr-sync has" >&2
                        echo "   not published this repo on this agent;" >&2
                        echo "   see seqpipe/infra#71)" >&2
                        exit 1
                    fi
                    # Accept EITHER manifest name: gain's directory GRR
                    # loader (fsspec_protocol.py load_contents) tries
                    # .CONTENTS.json.gz first and falls back to the
                    # uncompressed .CONTENTS.json.
                    if [ ! -f "$tree/.CONTENTS.json.gz" ] \
                       && [ ! -f "$tree/.CONTENTS.json" ]; then
                        echo "GRR not synced on this node yet: grr_seqpipe" >&2
                        echo "  ($resolved has no .CONTENTS manifest --" >&2
                        echo "   tree present but incomplete)" >&2
                        exit 1
                    fi
                    echo "OK: grr_seqpipe -> $resolved"
                '''
            }
        }

        stage('Build image') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                // Build from the repo root, like every other CI image. The
                // image carries only micromamba + rattler-index and a copy
                // of core/tests + core/pytest.ini (the test bed); the
                // .conda, the GRR tree and the reports dir are mounted at
                // run time, so this is cheap and the solve is always fresh.
                sh 'docker build -f core/conda-integration/Dockerfile \
                        -t ${IMAGE_TAG} .'
            }
        }

        // The package under test: the gain-core .conda the upstream root
        // build archived (`dist/conda/*.conda`, fingerprinted). Specific-
        // build copyArtifacts, the same shape gain-web-e2e uses for the
        // wheels and gpf-docs-e2e for this very artefact (gpf#916). The
        // default project follows BRANCH_NAME rather than master so a
        // manual run on a branch tests that branch's package; the
        // multibranch folder spells `/` in a branch name as `%2F`.
        //
        // Deliberately the LAST stage before the run rather than right
        // after `Checkout`: the root pipeline triggers this job from its
        // final stages and only archives `dist/conda` in `post`, so a copy
        // attempted too early can find a build that is still running with
        // nothing archived yet. Everything above (checkout, pre-flight, the
        // image build) is margin for the parent to finish.
        stage('Copy conda artefact') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                script {
                    String project = params.UPSTREAM_PROJECT?.trim() ?:
                        'iossifovlab/gain/' +
                        params.BRANCH_NAME.replace('/', '%2F')
                    def selector = params.UPSTREAM_BUILD?.trim()
                        ? specific(params.UPSTREAM_BUILD)
                        : lastSuccessful()
                    echo "Copying dist/conda/gain-core-*.conda from " +
                         "${project} " +
                         "(build ${params.UPSTREAM_BUILD ?: 'lastSuccessful'})"
                    copyArtifacts(
                        filter: 'dist/conda/gain-core-*.conda',
                        fingerprintArtifacts: true,
                        projectName: project,
                        selector: selector,
                    )
                }
                // Fail loud here rather than as an opaque "nothing provides
                // gain-core" mid-solve. Exactly one: the run script reads
                // the version off the filename, and two artefacts would
                // make "which one is under test" a guess.
                sh '''
                    ls -la dist/conda/
                    n="$(ls dist/conda/gain-core-*.conda 2>/dev/null | wc -l)"
                    if [ "$n" -ne 1 ]; then
                        echo "ERROR: expected exactly one gain-core-*.conda" \
                             "in dist/conda/, found $n" >&2
                        exit 1
                    fi
                '''
            }
        }

        stage('Conda integration tests') {
            when { expression { env.SUPERSEDED != 'true' } }
            steps {
                sh '''
                    # Create the bind source as the agent user, immediately
                    # before the run that consumes it. dockerd creates a
                    # MISSING one as root:root, and that root-owned directory
                    # is what wedges every subsequent build in this workspace
                    # (gain#921) -- so the fix is simply to never let it be
                    # missing. It cannot live in `Wipe workspace`: that runs
                    # before `Checkout`, whose cold-workspace clone path
                    # deletes the whole workspace (gain#917). Keeping it in
                    # the same script as the `docker run` is what stops the
                    # two drifting apart again.
                    mkdir -p reports/conda-integration

                    # Run as the agent user, not the image's mambauser, so
                    # the reports land on the host owned by the agent (same
                    # reason the root Jenkinsfile's `Conda packages` stage
                    # does it). HOME and MAMBA_ROOT_PREFIX point at /tmp
                    # because /opt/conda is not writable by an arbitrary UID;
                    # the env is solved under /tmp/env inside the container
                    # and discarded with it.
                    #
                    # The grr_seqpipe bind resolves the atomic-publish symlink
                    # (<root>/grr_seqpipe -> <root>/grr_seqpipe.<sha>) on the
                    # host at container start, so a sync landing mid-build
                    # cannot swap files under the suite -- the old snapshot is
                    # retained for a window (grr-sync#20). Mounted read-only;
                    # GRR_INTEGRATION_DIR makes the grr_seqpipe fixture read it
                    # as a directory repo instead of the http one.
                    #
                    # The image entrypoint (core/conda-integration/run.sh)
                    # indexes the channel, solves, asserts the installed gain
                    # is the artefact's, and runs the suite; its exit code is
                    # pytest's. It writes pytest.xml and the explicit env
                    # lockfile into /reports.
                    docker run --rm \
                        --name gain-conda-integration-${BUILD_NUMBER} \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -e MAMBA_ROOT_PREFIX=/tmp/mamba \
                        -e PYTHON_VERSION="${PYTHON_VERSION}" \
                        -v "$PWD/dist/conda:/dist/conda:ro" \
                        -v "${GRR_ROOT}/grr_seqpipe:/grr/grr_seqpipe:ro" \
                        -v "$PWD/reports/conda-integration:/reports" \
                        -e GRR_INTEGRATION_DIR=/grr/grr_seqpipe \
                        ${IMAGE_TAG}
                '''
            }
        }
    }

    post {
        always {
            script {
                junit(
                    allowEmptyResults: true,
                    testResults: 'reports/conda-integration/*.xml',
                )
                // The JUnit report plus conda-env.explicit.txt, the
                // explicit lockfile of what the solve picked: a red caused
                // by conda-forge/bioconda moving is diffed against the last
                // green's. Archived on failed runs too, which is where it
                // matters.
                archiveArtifacts(
                    artifacts: 'reports/conda-integration/*.xml, ' +
                               'reports/conda-integration/*.txt',
                    allowEmptyArchive: true,
                    fingerprint: false,
                )
            }
        }
        // `junit` above must run before these so the test-result action
        // zulipAlert() reads is already attached to the build.
        failure {
            // Wrapped in an explicit node block: a pipeline-init failure can
            // tear down the outer agent before post runs, leaving zulipSend
            // without a FilePath context. Same defensive pattern as
            // Jenkinsfile.nightly.
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        unstable {
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
        cleanup {
            sh 'docker rmi ${IMAGE_TAG} 2>/dev/null || true'
        }
    }
}
