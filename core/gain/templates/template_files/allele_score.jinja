{% extends "genomic_score.jinja" %}
{# An allele score's page IS the genomic-score page, plus one section and
   minus another. #}

{# An allele row collapses to the point it sits at, so there is no span
   to union and the coverage scan deliberately skips this kind.  Nothing
   would ever fill the section, so it renders no heading at all rather
   than one permanently reading "not computed" (gain#1118).

   This is the ONLY kind that empties it; the shared template carries
   Coverage as the block's default so that position and fragment scores
   -- and any kind added later that is genuinely scanned -- keep it
   without having to opt back in. #}
{% block coverage %}{% endblock %}

{% block alleles %}
<h2>Alleles</h2>
{% set alleles = impl.get_allele_display() %}
{% if alleles is not none %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th data-sort="text">Chromosome</th>
            <th data-sort="number">Alleles</th>
            {%- for name in alleles.class_names %}
            <th data-sort="number">{{ name }} %</th>
            {%- endfor %}
        </tr>
        {#- The total, pinned in the sticky header (gain#1118).  Its
           share cells are the resource-wide composition, which is what
           the "Allele classes" table below used to say in a table of
           its own; the per-chromosome counts it also showed are now
           the hover titles on the rows. -#}
        <tr>
            <td>all chromosomes</td>
            <td>{{ alleles.allele_count }}</td>
            {#- Titled with the resource-wide count, as the rows below
               are with their own: that count was a column of the
               removed classes table, and without it here the global
               number would be recoverable only by adding up the
               chromosomes' hover titles by hand. -#}
            {%- for name in alleles.class_names %}
            <td title="{{ alleles.class_counts[name] }} alleles">{% if alleles.class_percentages is not none -%}
                {{ alleles.class_percentages[name] }}
            {%- endif %}</td>
            {%- endfor %}
        </tr>
    </thead>
    <tbody>
    {%- for row in alleles.rows -%}
        <tr>
            <td data-sort-value="{{ natural_chromosome_key(row.chrom) }}">{{ row.chrom }}</td>
            <td data-sort-value="{{ row.allele_count }}">{{ row.allele_count }}</td>
            {#- The cell shows the share, sorts on the FRACTION and
               titles itself with the exact count -- the three
               renderings ClassShare carries.  Sorting on the rendered
               text would order "<0.01%" against "9.99%" as strings.

               A chromosome with no alleles has no composition, so its
               cells render empty and carry no key at all rather than
               an empty one, exactly as the Coverage table's row with
               no resolvable denominator does. -#}
            {%- for name in alleles.class_names %}
            {%- if row.shares is not none %}
            {%- set share = row.shares[name] %}
            <td data-sort-value="{{ share.fraction }}" title="{{ share.alleles }} alleles">{{ share.percentage }}</td>
            {%- else %}
            <td></td>
            {%- endif %}
            {%- endfor %}
        </tr>
    {%- endfor %}
    </tbody>
</table>
</div>
{% set allele_display = alleles.detail %}
<h3>Substitution matrix</h3>
{% if allele_display is not none and allele_display.substitution_matrix is not none %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>ref &rarr; alt</th>
            {%- for alt in allele_display.nucleotides %}
            <th>{{ alt }}</th>
            {%- endfor %}
        </tr>
    </thead>
    {%- for ref, cells in allele_display.matrix_rows() -%}
        <tr>
            <th>{{ ref }}</th>
            {%- for cell in cells -%}
            <td>{{ cell.alleles }}{% if cell.percentage is not none -%}
            <div class="text-muted">{{ cell.percentage }}</div>
            {%- endif %}</td>
            {%- endfor -%}
        </tr>
    {%- endfor %}
</table>
</div>
{#- The headline number of the matrix above, rendered as one rather
   than as a sentence in a <p>.  The second line is what the ratio is
   MADE of: both counts are computed already and were rendered nowhere,
   and 3/2 reads identically to 3,000,000/2,000,000 without them. -#}
<div class="key-figure">
    <div class="key-figure-label">ts/tv</div>
    {%- if allele_display.ts_tv is not none %}
    <div class="key-figure-value">{{ "%.2f"|format(allele_display.ts_tv) }}</div>
    <div class="key-figure-detail">{{ "{:,}".format(allele_display.transitions) }} transitions
        / {{ "{:,}".format(allele_display.transversions) }} transversions</div>
    {%- else %}
    {#- No transversions to divide by.  The counts still say why, and
       the transition count is the interesting half of that. -#}
    <div class="key-figure-value">not applicable</div>
    <div class="key-figure-detail">{{ "{:,}".format(allele_display.transitions) }} transitions
        / no transversions</div>
    {%- endif %}
</div>
{% else %}
<p>not computed</p>
{% endif %}
{# Each group asks for ITSELF.  The two are written together today, but
   gating the deletion image on the insertion group would silently drop
   a known histogram the day that stops holding. #}
<h3>Indel lengths</h3>
{% if allele_display is none
   or (allele_display.insertion_lengths is none
       and allele_display.deletion_lengths is none) %}
<p>not computed</p>
{% else %}
{% if allele_display.insertion_lengths is none %}
<p>insertion lengths not computed</p>
{% elif allele_display.insertion_lengths | sum %}
<img src="{{ impl.get_allele_insertion_lengths_image_filename() }}"
     alt="insertion length histogram" class="statistics-figure">
{% else %}
<p>no insertions</p>
{% endif %}
{% if allele_display.deletion_lengths is none %}
<p>deletion lengths not computed</p>
{% elif allele_display.deletion_lengths | sum %}
<img src="{{ impl.get_allele_deletion_lengths_image_filename() }}"
     alt="deletion length histogram" class="statistics-figure">
{% else %}
<p>no deletions</p>
{% endif %}
{% endif %}
<h3>Complex alleles</h3>
{% if allele_display is not none and allele_display.complex_grid is not none %}
{# Emptiness is asked of the OCCUPIED cells, the same way the threshold
   and the rows are: a grid whose every cell holds zero carries no
   complex allele, whatever its keys say. #}
{% set complex_rows = allele_display.complex_rows() %}
{% if not complex_rows %}
<p>no complex alleles</p>
{% elif allele_display.complex_grid_renders_as_table %}
{# Few enough lit cells that the heatmap would be a field of white:
   the table says the same thing in the rows it actually has.  No
   `data-sort` on any heading, so it does not opt into gain#984's
   column sorting -- it is at most COMPLEX_GRID_TABLE_MAX_CELLS rows
   and already ordered by the column that matters. #}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>reference length</th>
            <th>alternative length</th>
            <th>alleles</th>
            <th>% of complex</th>
        </tr>
    </thead>
    {%- for ref_length, alt_length, count, percentage in complex_rows -%}
        <tr>
            <td>{{ ref_length }}</td>
            <td>{{ alt_length }}</td>
            <td>{{ count }}</td>
            <td>{{ percentage }}</td>
        </tr>
    {%- endfor %}
</table>
</div>
{% else %}
<img src="{{ impl.get_allele_complex_grid_image_filename() }}"
     alt="complex allele length grid" class="statistics-figure">
{% endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% endblock %}
