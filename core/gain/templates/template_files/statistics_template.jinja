{# `static_root` is the page's climb back to the repository root, passed
   by the renderer from the path it publishes the page at: one directory
   per resource id segment, plus the `statistics/` directory this page
   sits in (gain#1400). #}
<html>
  <head>
    <meta charset="utf-8">
    <style>
      {% include "roboto_font.jinja" %}

      /* The same frame as the resource page: a header across the
         whole width, the content centred under it (gain#1477). */
      body {
        margin: 0;
      }

      .page-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 40px 100px;
      }

      {% include "base_styles.jinja" %}
      {% include "breadcrumb_styles.jinja" %}

      {% include styles_template %}
    </style>
  </head>
  <body>
    {% include "breadcrumb.jinja" %}
    <div class="page-content">
      <table>
        <thead>
          <tr>
            <th>Filename</th>
            <th>Size</th>
            <th>md5</th>
          </tr>
        </thead>
        <tbody>
          {%- for entry in data["statistic_files"] %}
          <tr>
            <td class="nowrap">
                <a href='{{entry.name}}'>{{entry.name}}</a>
            </td>
            <td class="nowrap">{{entry.size}}</td>
            <td class="nowrap">{{entry.md5}}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </body>
</html>
