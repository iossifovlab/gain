<html>
    <head>
     <meta charset="utf-8">
    <style>
      {# Roboto only: this page is styled text and renders no icon.  It
         used to carry the Material Symbols family too, which cost a
         ~3.8 MB woff2 to draw nothing at all.  Pinned by
         tests/small/templates/test_grr_page_icon_font.py. #}
      {% include "roboto_font.jinja" %}

      body {
        margin: 0;
      }

      {% include "base_styles.jinja" %}

      #section-about {
        margin: 40px 10%;
        color: #2d3d4a;
        line-height: 1.65;
      }

      #section-about h1 {
        font-size: 1.6em;
        font-weight: 700;
        color: #5b778c;
        margin: 0 0 16px;
      }

      #section-about h2 {
        font-size: 1.1em;
        font-weight: 700;
        color: #5b778c;
        margin: 2em 0 0.5em;
      }

      #section-about p {
        font-size: 0.875em;
        margin: 0 0 0.75em;
      }

      #section-about ul {
        font-size: 0.875em;
        list-style-type: '- ';
        padding-left: 15px;
        margin: 0 0 0.75em;
      }

      #section-about li {
        margin-bottom: 0.4em;
        padding-left: 4px;
      }

      {# Borders and spacing come from base_styles; only the size is set
         here, so a curator's table reads as part of the prose around it
         rather than a page element in its own right. #}
      #section-about table {
        font-size: 0.875em;
      }

      #section-about a {
        text-decoration: underline;
      }

      {% include "breadcrumb_styles.jinja" %}
    </style>
 </head>
    <body>
        {#- The same header bar as every other info page (gain#2483):
            the trail, and no About link, because this is the page it
            leads to. -#}
        {%- with show_about_link = false %}
        {% include "breadcrumb.jinja" %}
        {%- endwith %}
        <div id="section-about">
        {%- if about_contents %}
        {# about.md, already rendered to HTML by markdown2. #}
        {{about_contents|safe}}
        {%- else %}
        <p>This repository has no description yet.</p>
        {%- endif %}
        </div>
    </body>
</html>
