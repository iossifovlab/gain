{% extends "genomic_score.jinja" %}
{% import "length_statistics.jinja" as lengths %}
{# A fragment score's page IS the genomic-score page, plus one section. #}

{% block fragments %}
<h2>Fragments</h2>
{% set fragments = impl.get_fragment_display() %}
{% if fragments != None %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Chromosome</th>
            <th>Fragments</th>
        </tr>
        {#- Pinned in the sticky header rather than <tfoot>, as the
           Coverage and Alleles totals are, and with <td> cells for the
           same reason.  This table does not opt into sorting yet; it
           keeps the shape of its two siblings so that opting in stays
           two attributes and nothing else. -#}
        <tr>
            <td>all chromosomes</td>
            <td>{{ fragments.global_fragments }}</td>
        </tr>
    </thead>
    <tbody>
    {%- for row in fragments.rows -%}
        <tr>
            <td>{{ row.chrom }}</td>
            <td>{{ row.fragments }}</td>
        </tr>
    {%- endfor %}
    </tbody>
</table>
</div>
<h3>Fragment lengths</h3>
{#- Three answers, not two.  The counts and the lengths are read
   independently: a file that stored the counts alone (format version
   1) leaves the LENGTHS unknown while the counts above stay exact.
   Collapsing that into the empty branch would print "no fragments"
   directly beneath a table saying there are several.  The coverage
   and allele sections draw the same three-way distinction. -#}
{% if fragments.fragment_lengths is none %}
<p>fragment lengths not computed</p>
{% elif not fragments.fragment_lengths.has_counts_to_plot %}
<p>no fragments</p>
{% else %}
{% call lengths.statistics_table("fragments") %}
        {{ lengths.statistics_row(fragments.fragment_row) }}
{%- endcall %}
{#- The chart as a thumbnail the size one indel chart has, opening the
   full-size image in the modal this page already uses for the score
   histograms -- so the smaller size costs no detail.  A pair of one:
   the shared thumbnail rule does not grow, so it keeps half the row. -#}
<div class="figure-pair">
{{ lengths.figure_thumbnail(
       impl.get_fragment_lengths_image_filename(),
       "global fragment-length histogram", "modal-fragment-lengths") }}
</div>
{{ lengths.figure_modal(
       "modal-fragment-lengths", "fragment lengths",
       impl.get_fragment_lengths_image_filename(),
       "global fragment-length histogram") }}
{%- endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% endblock %}
