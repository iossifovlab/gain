{% extends "genomic_score.jinja" %}
{# A fragment score's page IS the genomic-score page, plus one section
   and minus another. #}

{# A fragment score's rows deliberately OVERLAP, so the union of their
   spans measures nothing a reader wants: not fragments -- that is the
   section below, and it is the honest one -- and not completeness in a
   way that compares across resources.  The kind is therefore not
   coverage-scanned at all, so nothing would ever fill the section and
   it renders no heading rather than one permanently reading "not
   computed" (gain#1127).  ADR 0020 records the adjacent half: no
   segments either, for the same reason. #}
{% block coverage %}{% endblock %}

{% block fragments %}
<h2>Fragments</h2>
{% set fragments = impl.get_fragment_display() %}
{% if fragments != None %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Chromosome</th>
            <th>Fragments</th>
        </tr>
        {#- Pinned in the sticky header rather than <tfoot>, as the
           Coverage and Alleles totals are, and with <td> cells for the
           same reason.  This table does not opt into sorting yet; it
           keeps the shape of its two siblings so that opting in stays
           two attributes and nothing else. -#}
        <tr>
            <td>all chromosomes</td>
            <td>{{ fragments.global_fragments }}</td>
        </tr>
    </thead>
    <tbody>
    {%- for row in fragments.rows -%}
        <tr>
            <td>{{ row.chrom }}</td>
            <td>{{ row.fragments }}</td>
        </tr>
    {%- endfor %}
    </tbody>
</table>
</div>
<h3>Fragment lengths</h3>
{#- Three answers, not two.  The counts and the histogram are read
   independently: a stored histogram binned on foreign edges cannot
   merge with this code's fixed bins, so the LENGTHS are unknown while
   the counts above stay exact.  Collapsing that into the empty branch
   would print "no fragments" directly beneath a table saying there are
   several.  The allele sections draw the same three-way distinction. -#}
{% if fragments.fragment_lengths is none %}
<p>fragment lengths not computed</p>
{% elif fragments.fragment_lengths | sum %}
<img src="{{ impl.get_fragment_lengths_image_filename() }}"
    alt="global fragment-length histogram"
    class="statistics-figure"
    title="Fragment lengths across all chromosomes, fixed log2 bins">
{% else %}
<p>no fragments</p>
{% endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% endblock %}
