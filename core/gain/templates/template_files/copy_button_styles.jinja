{# The copy-to-clipboard icon's look, shared by the index page's rows
   and the resource page's Id cell (gain#1477).  The glyph itself is a
   Material Symbols ligature, so the element also needs the icon class
   from `icon_font.jinja`. #}
      .copy-icon {
        font-size: 20px;
        color: #B9D3E7;
      }

      .copy-icon:hover {
        cursor: pointer;
        color: #85A2B9;
      }
