      *, *::before, *::after {
        box-sizing: border-box;
        font-family: "Roboto", system-ui, -apple-system, sans-serif;
      }

      body {
        color: #252e34;
      }
      
      h1, h2, h3, h4, h5, h6 {
        color: #5b778c;
      }

      h2 {
        margin-top: 50px;
        margin-bottom: 10px;
      }

      h3,h4 {
        margin-top:0.5em;
        margin-bottom:0.5em;
      }

      table {
        border-collapse: collapse;
        width: 100%
      }

      th {
        background: #ecf1f6;
      }

      td,
      th {
        border: 1px solid #cfd8df;
        padding: 5px 10px;
        overflow-wrap: break-word;
      }

      tr {
        height: 38px;
      }

      ul {
        list-style-type: '-  ';
        padding-left: 15px;
        margin: 0;
      }

      a {
        text-decoration: none;
        color: #24699E;
      }

      a:hover {
        color: #4C93C9;
      }

      .nowrap {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      #page-header {
        display: flex;
        align-items: center;
        padding: 14px clamp(20px, 10%, 64px);
        border-bottom: 1px solid #e4edf2;
      }

      #page-header a {
        color: #24699E;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.15s ease-out;
        font-size: 18px;
      }

      #page-header a:hover {
        color: #4C93C9;
      }

      .histogram {
        margin-bottom: 16px;
      }

      .histogram-thumbnail {
        max-width: 200px;
        cursor: pointer;
      }

      /* No page-flow image overflows the content box.  `:where` holds
         this at zero specificity, so it is a floor every other rule
         overrides -- notably the thumbnail cap above, which a plain
         `.page-content img` would outrank. */
      :where(.page-content) img {
        max-width: 100%;
      }

      .statistics-figure {
        display: block;
        width: 100%;
        height: auto;
      }

      /* Two related figures side by side, each about half width, so the
         pair reads as one comparison and occupies one row.  It wraps to
         a column when there is not room for two, which is what keeps
         this from needing a media query. */
      .figure-pair {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 16px;
      }

      /* Sized by the row rather than by the image: each takes half the
         pair minus the gap, and shrinks together with it. */
      .figure-pair > .figure-thumbnail {
        flex: 1 1 calc(50% - 16px);
        min-width: 0;
        height: auto;
        cursor: pointer;
      }

      /* One number worth reading on its own, with the quantities it
         was computed from underneath it.  Sized to sit under a table
         without competing with the <h3> above it: inline-block so the
         tint stops at the number rather than running the page width. */
      .key-figure {
        display: inline-block;
        border: 1px solid #cfd8df;
        border-radius: 4px;
        background-color: #f7f9fa;
        padding: 10px 16px;
        margin-bottom: 16px;
      }

      .key-figure-label {
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #919191;
      }

      .key-figure-value {
        font-size: 1.8em;
        font-weight: bold;
        line-height: 1.2;
      }

      .key-figure-detail {
        font-size: 0.9em;
        color: #919191;
      }

      .text-muted {
        color: #919191;
      }

      .scrollable-table-container {
        max-height: 500px;
        overflow-y: auto;
        margin-bottom: 16px;
      }

      .scrollable-table-container thead {
        position: sticky;
        top: 0;
        background-color: white;
      }

      .scrollable-table-container table {
        border-collapse: separate;
        border-spacing: 0;
      }
      .scrollable-table-container th {
        border: 0;
        border-top: 1px solid #cfd8df;
        border-bottom: 1px solid #cfd8df;
        border-right: 1px solid #cfd8df;
      }
      .scrollable-table-container td {
        border: 0;
        border-bottom: 1px solid #cfd8df;
        border-right: 1px solid #cfd8df;
      }
      .scrollable-table-container th:first-child,
      .scrollable-table-container td:first-child {
        border-left: 1px solid #cfd8df;
      }
      #chromosomes-table thead tr:nth-of-type(2) th {
        border-top: none;
      }
