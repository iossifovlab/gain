{% extends base %}
{# Set outside the block so every child template's block sees them:
   a nested block does not inherit a `set` made inside its parent. #}
{% set impl = data.genomic_scores %}
{% set scores = impl.score %}
{% block content %}

<h2>Scores ({{ scores.score_definitions|length }})</h2>
<div class="scrollable-table-container">  
<table>
    <colgroup>
        <col style="width: 15%">
        <col style="width: 6%">
        <col style="width: 15%">
        <col>
        <col style="width: 220px">
        <col style="width: 15%">
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Default annotation</th>
            <th>Description</th>
            <th>Histogram</th>
            <th>Range</th>
        </tr>
    </thead>

    {%- for score_id, score in scores.score_definitions.items() -%}
        <tr class="score-definition">
            <td>{{ score_id }}</td>
            <td>{{ score.value_type }}</td>
            {% set d_atts = scores.get_default_annotation_attribute(score_id) %}
            {% if d_atts != None %}
                <td>
                    <p>{{ d_atts }}</p>
                </td>
            {% else %}
                <td>
                    <p>-</p>
                </td>
            {% endif %}

            <td>
                <div>{{ score.desc }}</div>
                {% if score.small_values_desc %}
                    <div class="text-muted">
                        {{ "Small values desc: " + score.small_values_desc }}
                    </div>
                {% endif %}
                {% if score.large_values_desc %}
                    <div class="text-muted">
                        {{ "Large values desc: " + score.large_values_desc }}
                    </div>
                {% endif %}
            </td>
            <td style="text-align: center">
                {% set hist = impl.score.get_score_histogram(score_id, truncated=True) %}
                {%- if hist.type != 'null_histogram' %}
                {% set hist_image_file = impl.score.get_histogram_image_filename(score_id) %}
                <img src="{{ hist_image_file }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_") }}"
                    class="histogram-thumbnail"
                    data-modal-trigger="modal-{{ score_id | replace(" ", "_") }}">
                {%- else -%}
                <p>No histogram: {{ hist.reason }}</p>
                {%- endif -%}
            </td>
            <td>
            {%- if hist.type != 'null_histogram' %}
                {{ hist.values_domain() }}
            {%- else -%}
                NO DOMAIN
            {%- endif -%}
            </td>
        </tr>
    {%- endfor %}
    {#- An annulled histogram has no image on disk, so it gets no modal --
        the thumbnail that opens one is not rendered for it either. #}
    {%- for score_id in scores.score_definitions.keys() -%}
        {%- set modal_hist = impl.score.get_score_histogram(
            score_id, truncated=True) -%}
        {%- if modal_hist.type != 'null_histogram' %}
        <div id="modal-{{score_id | replace(" ", "_")}}" class="modal">
            <div class="modal-content">
                <span title="{{score_id | replace(" ", "_")}}" class="close">&times;</span>
                <img src="{{ impl.score.get_histogram_image_filename(score_id) }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_")}}"
                    style="max-width: min(100%, 800px);">
            </div>
        </div>
        {%- endif -%}
    {%- endfor %}
</table>
</div>

{# FILLED by default, unlike the two blocks below -- the asymmetry is the
   point.  Coverage applies to every kind this template serves except
   one: position and fragment scores are both span-union scanned
   (``_COVERAGE_SCAN_RESOURCE_TYPES``), and an allele score is not, so
   the exception overrides this block empty rather than every other kind
   having to fill it (gain#1118).

   Keyed on the KIND, which is what choosing a template already is, and
   never on ``get_coverage_display()`` returning None: a position score
   whose statistics are not built yet must keep reading "not computed",
   where the message is true and a rebuild acts on it.  Gating on the
   payload would collapse *never applicable* and *not yet built* into
   one silent blank. #}
{% block coverage %}
<h2>Coverage</h2>
{% set coverage = impl.get_coverage_display() %}
{% if coverage != None %}
{% set has_fractions = coverage.has_fractions %}
{% set has_segments = coverage.has_segments %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th data-sort="text">Chromosome</th>
            <th data-sort="number">Covered positions</th>
            {%- if has_fractions %}
            <th data-sort="number">Covered %</th>
            {%- endif %}
            {%- if has_segments %}
            <th data-sort="number">Segments</th>
            {%- endif %}
        </tr>
        {#- The total is pinned as a SECOND head row so it stays in view
           down a few hundred contigs: the scrollable container already
           makes `thead` sticky, and this inherits it for nothing.

           It is as safe from the sorter here as it was in <tfoot>, and
           for a structural reason rather than a promise: the script
           reads its headers from `tHead.rows[0]` and reorders only
           `tBodies[0].rows`, so this row is outside both.

           <td>, never <th>: a <th> here would be announced as a column
           header for the data below, and would match the
           `thead th[aria-sort]` query the sorter clears the previous
           column's marker with. -#}
        <tr>
            <td>all chromosomes</td>
            <td>{{ coverage.global_covered }}</td>
            {%- if has_fractions %}
            {#- Guarded on the fraction, exactly as the per-chromosome
               cell above is: "did a denominator resolve" is one
               question, and the two cells must not read it off two
               different fields. -#}
            <td>{% if coverage.global_fraction != None -%}
                {{ coverage.global_percent }}
            {%- endif %}</td>
            {%- endif %}
            {%- if has_segments %}
            <td>{{ coverage.global_segments }}</td>
            {%- endif %}
        </tr>
    </thead>
    <tbody>
    {%- for row in coverage.rows -%}
        <tr>
            <td data-sort-value="{{ natural_chromosome_key(row.chrom) }}">{{ row.chrom }}</td>
            <td data-sort-value="{{ row.covered }}">{{ row.covered }}</td>
            {#- The cell shows a percentage and sorts on the fraction.
               Both come off the row rather than being formatted here:
               the share is written by the one rule the Alleles tables
               below use too, and a "%.2f%%" here would be a second
               copy of that rule -- which is exactly what this page
               carried, and what gain#1057 removed.
               A row with no denominator renders empty and carries no
               attribute at all rather than an empty one.  The sorter
               treats both as "no value", so this is about the markup
               saying what it means: a cell with nothing to sort on
               carries no key, instead of a key that happens to be
               blank. -#}
            {%- if has_fractions -%}
            {%- if row.fraction != None %}
            <td data-sort-value="{{ row.fraction }}">{{ row.percent }}</td>
            {%- else %}
            <td></td>
            {%- endif %}
            {%- endif %}
            {%- if has_segments %}
            <td data-sort-value="{{ row.segments }}">{{ row.segments }}</td>
            {%- endif %}
        </tr>
    {%- endfor %}
    </tbody>
    {#- The untouched part of the reference (see UncoveredContigs for why
       it is one row) stays in <tfoot>, and is now the only thing in it.

       It did not follow the total into the sticky header, because it is
       not a total: it describes what is NOT in the table.  Pinning it
       would also make the sticky header three rows deep and eat the
       500px the data scrolls in.  Out of <tbody> for the same reason as
       ever -- the sorter reorders tbody > tr only, so no comparator can
       float a summary into the middle of the data.

       The element itself is conditional now that the total has left it:
       most resources have no uncovered contigs, and an always-emitted
       <tfoot></tfoot> would be an empty element on every one of them. -#}
    {%- if coverage.uncovered != None %}
    {%- set uncovered = coverage.uncovered %}
    <tfoot>
    <tr>
        <td>{{ uncovered.contigs }} {{ "contig" if uncovered.contigs == 1 else "contigs" }} with no values ({{ uncovered.length }} bp)</td>
        <td>0</td>
        {%- if has_fractions %}
        <td>{{ uncovered.percent }}</td>
        {%- endif %}
        {%- if has_segments %}
        <td>0</td>
        {%- endif %}
    </tr>
    </tfoot>
    {%- endif %}
</table>
</div>
{%- if has_segments %}
<h3>Segment lengths</h3>
{# Known-and-empty states itself, as the indel groups do: with
   no positive count there is nothing to draw and no image is written,
   so linking one would dangle. #}
{% if coverage.segment_lengths and coverage.segment_lengths | sum %}
<img src="{{ impl.get_coverage_segment_lengths_image_filename() }}"
    alt="global segment-length histogram"
    class="statistics-figure"
    title="Segment lengths across all chromosomes, fixed log2 bins">
{% else %}
<p>no segments</p>
{% endif %}
{%- endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% endblock %}

{# Empty by default, for the reason the fragments block below is:
   a kind whose rows carry no ref/alt pair can never fill this
   section, and a heading permanently reading "not computed" says
   the opposite -- that a rebuild would fill it in (gain#1105).
   Filled by allele_score.jinja. #}
{% block alleles %}{% endblock %}

{# Empty by default: a kind with nothing to say here renders no section
   at all, rather than a heading that reads "not computed" forever.
   Filled by fragment_score.jinja. #}
{% block fragments %}{% endblock %}
{% endblock %}
