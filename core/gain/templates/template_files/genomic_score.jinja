{% extends base %}
{# Set outside the block so every child template's block sees them:
   a nested block does not inherit a `set` made inside its parent. #}
{% set impl = data.genomic_scores %}
{% set scores = impl.score %}
{% block content %}

<h2>Scores ({{ scores.score_definitions|length }})</h2>
<div class="scrollable-table-container">  
<table>
    <colgroup>
        <col style="width: 15%">
        <col style="width: 6%">
        <col style="width: 15%">
        <col>
        <col style="width: 220px">
        <col style="width: 15%">
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Default annotation</th>
            <th>Description</th>
            <th>Histogram</th>
            <th>Range</th>
        </tr>
    </thead>

    {%- for score_id, score in scores.score_definitions.items() -%}
        <tr class="score-definition">
            <td>{{ score_id }}</td>
            <td>{{ score.value_type }}</td>
            {% set d_atts = scores.get_default_annotation_attribute(score_id) %}
            {% if d_atts != None %}
                <td>
                    <p>{{ d_atts }}</p>
                </td>
            {% else %}
                <td>
                    <p>-</p>
                </td>
            {% endif %}

            <td>
                <div>{{ score.desc }}</div>
                {% if score.small_values_desc %}
                    <div class="text-muted">
                        {{ "Small values desc: " + score.small_values_desc }}
                    </div>
                {% endif %}
                {% if score.large_values_desc %}
                    <div class="text-muted">
                        {{ "Large values desc: " + score.large_values_desc }}
                    </div>
                {% endif %}
            </td>
            <td style="text-align: center">
                {% set hist = impl.score.get_score_histogram(score_id, truncated=True) %}
                {%- if hist.type != 'null_histogram' %}
                {% set hist_image_file = impl.score.get_histogram_image_filename(score_id) %}
                <img src="{{ hist_image_file }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_") }}"
                    class="histogram-thumbnail"
                    data-modal-trigger="modal-{{ score_id | replace(" ", "_") }}">
                {%- else -%}
                <p>No histogram: {{ hist.reason }}</p>
                {%- endif -%}
            </td>
            <td>
            {%- if hist.type != 'null_histogram' %}
                {{ hist.values_domain() }}
            {%- else -%}
                NO DOMAIN
            {%- endif -%}
            </td>
        </tr>
    {%- endfor %}
    {%- for score_id in scores.score_definitions.keys() -%}
        <div id="modal-{{score_id | replace(" ", "_")}}" class="modal">
            <div class="modal-content">
                <span title="{{score_id | replace(" ", "_")}}" class="close">&times;</span>
                <img src="{{ impl.score.get_histogram_image_filename(score_id) }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_")}}"
                    style="max-width: min(100%, 800px);">
            </div>
        </div>
    {%- endfor %}
</table>
</div>

<h2>Coverage</h2>
{% set coverage = impl.get_coverage_display() %}
{% if coverage != None %}
{% set has_fractions = coverage.has_fractions %}
{% set has_segments = coverage.has_segments %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th data-sort="text">Chromosome</th>
            <th data-sort="number">Covered positions</th>
            {%- if has_fractions %}
            <th data-sort="number">Covered %</th>
            {%- endif %}
            {%- if has_segments %}
            <th data-sort="number">Segments</th>
            {%- endif %}
        </tr>
    </thead>
    <tbody>
    {%- for row in coverage.rows -%}
        <tr>
            <td data-sort-value="{{ natural_chromosome_key(row.chrom) }}">{{ row.chrom }}</td>
            <td data-sort-value="{{ row.covered }}">{{ row.covered }}</td>
            {#- The cell shows a percentage and sorts on the fraction.
               A row with no denominator renders empty and carries no
               attribute at all rather than an empty one.  The sorter
               treats both as "no value", so this is about the markup
               saying what it means: a cell with nothing to sort on
               carries no key, instead of a key that happens to be
               blank. -#}
            {%- if has_fractions -%}
            {%- if row.fraction != None %}
            <td data-sort-value="{{ row.fraction }}">{{ "%.2f%%"|format(row.fraction * 100) }}</td>
            {%- else %}
            <td></td>
            {%- endif %}
            {%- endif %}
            {%- if has_segments %}
            <td data-sort-value="{{ row.segments }}">{{ row.segments }}</td>
            {%- endif %}
        </tr>
    {%- endfor %}
    </tbody>
    <tfoot>
    <tr>
        <td>all chromosomes</td>
        <td>{{ coverage.global_covered }}</td>
        {%- if has_fractions %}
        <td>{% if coverage.global_fraction != None -%}
            {{ "%.2f%%"|format(coverage.global_fraction * 100) }}
        {%- endif %}</td>
        {%- endif %}
        {%- if has_segments %}
        <td>{{ coverage.global_segments }}</td>
        {%- endif %}
    </tr>
    </tfoot>
</table>
</div>
{%- if has_segments %}
<h3>Segment lengths</h3>
{# Known-and-empty states itself, as the indel groups do: with
   no positive count there is nothing to draw and no image is written,
   so linking one would dangle. #}
{% if coverage.segment_lengths and coverage.segment_lengths | sum %}
<img src="{{ impl.get_coverage_segment_lengths_image_filename() }}"
    alt="global segment-length histogram"
    title="Segment lengths across all chromosomes, fixed log2 bins">
{% else %}
<p>no segments</p>
{% endif %}
{%- endif %}
{% else %}
<p>not computed</p>
{% endif %}

<h2>Alleles</h2>
{% set alleles = impl.get_allele_statistics() %}
{% if alleles is not none %}
{% set global_alleles = alleles.global_counts() %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th data-sort="text">Chromosome</th>
            <th data-sort="number">Covered positions</th>
            <th data-sort="number">Alleles</th>
        </tr>
    </thead>
    <tbody>
    {%- for chrom, counts in alleles.by_chromosome().items() -%}
        <tr>
            <td data-sort-value="{{ natural_chromosome_key(chrom) }}">{{ chrom }}</td>
            <td data-sort-value="{{ counts.covered_positions }}">{{ counts.covered_positions }}</td>
            <td data-sort-value="{{ counts.allele_count }}">{{ counts.allele_count }}</td>
        </tr>
    {%- endfor %}
    </tbody>
    <tfoot>
    <tr>
        <td>all chromosomes</td>
        <td>{{ global_alleles.covered_positions }}</td>
        <td>{{ global_alleles.allele_count }}</td>
    </tr>
    </tfoot>
</table>
</div>
<h3>Allele classes</h3>
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Class</th>
            <th>Alleles</th>
        </tr>
    </thead>
    {%- for name, count in global_alleles.class_counts.items() -%}
        <tr>
            <td>{{ name }}</td>
            <td>{{ count }}</td>
        </tr>
    {%- endfor %}
</table>
</div>
<h3>Substitution matrix</h3>
{% set allele_display = global_alleles.display() %}
{% if allele_display is not none and allele_display.substitution_matrix is not none %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>ref &rarr; alt</th>
            {%- for alt in allele_display.nucleotides %}
            <th>{{ alt }}</th>
            {%- endfor %}
        </tr>
    </thead>
    {%- for ref, cells in allele_display.matrix_rows() -%}
        <tr>
            <th>{{ ref }}</th>
            {%- for count in cells -%}
            <td>{{ count }}</td>
            {%- endfor -%}
        </tr>
    {%- endfor %}
</table>
</div>
<p>ts/tv ratio:
{%- if allele_display.ts_tv is not none %}
{{ "%.2f"|format(allele_display.ts_tv) }}
{%- else %}
not applicable
{%- endif %}</p>
{% else %}
<p>not computed</p>
{% endif %}
{# Each group asks for ITSELF.  The two are written together today, but
   gating the deletion image on the insertion group would silently drop
   a known histogram the day that stops holding. #}
<h3>Indel lengths</h3>
{% if allele_display is none
   or (allele_display.insertion_lengths is none
       and allele_display.deletion_lengths is none) %}
<p>not computed</p>
{% else %}
{% if allele_display.insertion_lengths is none %}
<p>insertion lengths not computed</p>
{% elif allele_display.insertion_lengths | sum %}
<img src="{{ impl.get_allele_insertion_lengths_image_filename() }}"
     alt="insertion length histogram" style="width:50%">
{% else %}
<p>no insertions</p>
{% endif %}
{% if allele_display.deletion_lengths is none %}
<p>deletion lengths not computed</p>
{% elif allele_display.deletion_lengths | sum %}
<img src="{{ impl.get_allele_deletion_lengths_image_filename() }}"
     alt="deletion length histogram" style="width:50%">
{% else %}
<p>no deletions</p>
{% endif %}
{% endif %}
<h3>Complex alleles</h3>
{% if allele_display is not none and allele_display.complex_grid is not none %}
{% if allele_display.complex_grid %}
<img src="{{ impl.get_allele_complex_grid_image_filename() }}"
     alt="complex allele length grid" style="width:50%">
{% else %}
<p>no complex alleles</p>
{% endif %}
{% else %}
<p>not computed</p>
{% endif %}
{% else %}
<p>not computed</p>
{% endif %}

{# Empty by default: a kind with nothing to say here renders no section
   at all, rather than a heading that reads "not computed" forever.
   Filled by fragment_score.jinja. #}
{% block fragments %}{% endblock %}
{% endblock %}
