{% extends base %}
{% block content %}
{% set impl = data.genomic_scores %}
{% set scores = impl.score %}

<h2>Scores ({{ scores.score_definitions|length }})</h2>
<div class="scrollable-table-container">  
<table>
    <colgroup>
        <col style="width: 15%">
        <col style="width: 6%">
        <col style="width: 15%">
        <col>
        <col style="width: 220px">
        <col style="width: 15%">
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Default annotation</th>
            <th>Description</th>
            <th>Histogram</th>
            <th>Range</th>
        </tr>
    </thead>

    {%- for score_id, score in scores.score_definitions.items() -%}
        <tr class="score-definition">
            <td>{{ score_id }}</td>
            <td>{{ score.value_type }}</td>
            {% set d_atts = scores.get_default_annotation_attribute(score_id) %}
            {% if d_atts != None %}
                <td>
                    <p>{{ d_atts }}</p>
                </td>
            {% else %}
                <td>
                    <p>-</p>
                </td>
            {% endif %}

            <td>
                <div>{{ score.desc }}</div>
                {% if score.small_values_desc %}
                    <div class="text-muted">
                        {{ "Small values desc: " + score.small_values_desc }}
                    </div>
                {% endif %}
                {% if score.large_values_desc %}
                    <div class="text-muted">
                        {{ "Large values desc: " + score.large_values_desc }}
                    </div>
                {% endif %}
            </td>
            <td style="text-align: center">
                {% set hist = impl.score.get_score_histogram(score_id, truncated=True) %}
                {%- if hist.type != 'null_histogram' %}
                {% set hist_image_file = impl.score.get_histogram_image_filename(score_id) %}
                <img src="{{ hist_image_file }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_") }}"
                    class="histogram-thumbnail"
                    data-modal-trigger="modal-{{ score_id | replace(" ", "_") }}">
                {%- else -%}
                <p>No histogram: {{ hist.reason }}</p>
                {%- endif -%}
            </td>
            <td>
            {%- if hist.type != 'null_histogram' %}
                {{ hist.values_domain() }}
            {%- else -%}
                NO DOMAIN
            {%- endif -%}
            </td>
        </tr>
    {%- endfor %}
    {%- for score_id in scores.score_definitions.keys() -%}
        <div id="modal-{{score_id | replace(" ", "_")}}" class="modal">
            <div class="modal-content">
                <span title="{{score_id | replace(" ", "_")}}" class="close">&times;</span>
                <img src="{{ impl.score.get_histogram_image_filename(score_id) }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_")}}"
                    style="max-width: min(100%, 800px);">
            </div>
        </div>
    {%- endfor %}
</table>
</div>

<h2>Coverage</h2>
{% set coverage = impl.get_coverage_display() %}
{% if coverage != None %}
{% set has_fractions = coverage.has_fractions %}
{% set has_segments = coverage.has_segments %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Chromosome</th>
            <th>Covered positions</th>
            {%- if has_fractions %}
            <th>Covered %</th>
            {%- endif %}
            {%- if has_segments %}
            <th>Segments</th>
            {%- endif %}
        </tr>
    </thead>
    {%- for row in coverage.rows -%}
        <tr>
            <td>{{ row.chrom }}</td>
            <td>{{ row.covered }}</td>
            {%- if has_fractions %}
            <td>{% if row.fraction != None -%}
                {{ "%.2f%%"|format(row.fraction * 100) }}
            {%- endif %}</td>
            {%- endif %}
            {%- if has_segments %}
            <td>{{ row.segments }}</td>
            {%- endif %}
        </tr>
    {%- endfor %}
    <tr class="coverage-global">
        <td>all chromosomes</td>
        <td>{{ coverage.global_covered }}</td>
        {%- if has_fractions %}
        <td>{% if coverage.global_fraction != None -%}
            {{ "%.2f%%"|format(coverage.global_fraction * 100) }}
        {%- endif %}</td>
        {%- endif %}
        {%- if has_segments %}
        <td>{{ coverage.global_segments }}</td>
        {%- endif %}
    </tr>
</table>
</div>
{%- if has_segments %}
<h3>Segment lengths</h3>
<img src="{{ impl.get_coverage_segment_lengths_image_filename() }}"
    alt="global segment-length histogram"
    title="Segment lengths across all chromosomes, fixed log2 bins">
{%- endif %}
{% else %}
<p>not computed</p>
{% endif %}

<h2>Alleles</h2>
{% set alleles = impl.get_allele_statistics() %}
{% if alleles is not none %}
{% set global_alleles = alleles.global_counts() %}
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Chromosome</th>
            <th>Covered positions</th>
            <th>Alleles</th>
        </tr>
    </thead>
    {%- for chrom, counts in alleles.by_chromosome().items() -%}
        <tr>
            <td>{{ chrom }}</td>
            <td>{{ counts.covered_positions }}</td>
            <td>{{ counts.allele_count }}</td>
        </tr>
    {%- endfor %}
    <tr>
        <td>all chromosomes</td>
        <td>{{ global_alleles.covered_positions }}</td>
        <td>{{ global_alleles.allele_count }}</td>
    </tr>
</table>
</div>
<h3>Allele classes</h3>
<div class="scrollable-table-container">
<table>
    <thead>
        <tr>
            <th>Class</th>
            <th>Alleles</th>
        </tr>
    </thead>
    {%- for name, count in global_alleles.class_counts.items() -%}
        <tr>
            <td>{{ name }}</td>
            <td>{{ count }}</td>
        </tr>
    {%- endfor %}
</table>
</div>
{% else %}
<p>not computed</p>
{% endif %}
{% endblock %}
