{% extends base %}
{# Set outside the block so every child template's block sees them:
   a nested block does not inherit a `set` made inside its parent. #}
{% set impl = data.genomic_scores %}
{% set scores = impl.score %}
{% block content %}

<h2>Scores ({{ scores.score_definitions|length }})</h2>
<div class="scrollable-table-container">  
<table>
    <colgroup>
        <col style="width: 15%">
        <col style="width: 6%">
        <col style="width: 15%">
        <col>
        <col style="width: 220px">
        <col style="width: 15%">
    </colgroup>
    <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Default annotation</th>
            <th>Description</th>
            <th>Histogram</th>
            <th>Range</th>
        </tr>
    </thead>

    {%- for score_id, score in scores.score_definitions.items() -%}
        <tr class="score-definition">
            <td>{{ score_id }}</td>
            <td>{{ score.value_type }}</td>
            {% set d_atts = scores.get_default_annotation_attribute(score_id) %}
            {% if d_atts != None %}
                <td>
                    <p>{{ d_atts }}</p>
                </td>
            {% else %}
                <td>
                    <p>-</p>
                </td>
            {% endif %}

            <td>
                <div>{{ score.desc }}</div>
                {% if score.small_values_desc %}
                    <div class="text-muted">
                        {{ "Small values desc: " + score.small_values_desc }}
                    </div>
                {% endif %}
                {% if score.large_values_desc %}
                    <div class="text-muted">
                        {{ "Large values desc: " + score.large_values_desc }}
                    </div>
                {% endif %}
            </td>
            <td style="text-align: center">
                {% set hist = impl.score.get_score_histogram(score_id, truncated=True) %}
                {%- if hist.type != 'null_histogram' %}
                {% set hist_image_file = impl.score.get_histogram_image_filename(score_id) %}
                <img src="{{ hist_image_file }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_") }}"
                    class="histogram-thumbnail"
                    data-modal-trigger="modal-{{ score_id | replace(" ", "_") }}">
                {%- else -%}
                <p>No histogram: {{ hist.reason }}</p>
                {%- endif -%}
            </td>
            <td>
            {%- if hist.type != 'null_histogram' %}
                {{ hist.values_domain() }}
            {%- else -%}
                NO DOMAIN
            {%- endif -%}
            </td>
        </tr>
    {%- endfor %}
    {#- An annulled histogram has no image on disk, so it gets no modal --
        the thumbnail that opens one is not rendered for it either. #}
    {%- for score_id in scores.score_definitions.keys() -%}
        {%- set modal_hist = impl.score.get_score_histogram(
            score_id, truncated=True) -%}
        {%- if modal_hist.type != 'null_histogram' %}
        <div id="modal-{{score_id | replace(" ", "_")}}" class="modal">
            <div class="modal-content">
                <span title="{{score_id | replace(" ", "_")}}" class="close">&times;</span>
                <img src="{{ impl.score.get_histogram_image_filename(score_id) }}"
                    alt="{{ "HISTOGRAM FOR " + score_id }}"
                    title="{{ score_id | replace(" ", "_")}}"
                    style="max-width: min(100%, 800px);">
            </div>
        </div>
        {%- endif -%}
    {%- endfor %}
</table>
</div>

{# Empty by default, as the two blocks below are.  Covered positions are
   a POSITION SCORE statistic and only that: the union measures what a
   resource covers exactly when its rows are pairwise disjoint.  An
   allele score's rows are points, so there is no span to union
   (gain#1118); a fragment score's rows overlap, so the union counts
   nothing anyone asks for (gain#1127).  Filled by position_score.jinja.

   Every section is a slot here, so a kind added later inherits no
   section it cannot fill -- the kind -> section relation is which
   template a class names, and nothing else (gain#1210). #}
{% block coverage %}{% endblock %}

{# Empty by default, for the reason the fragments block below is:
   a kind whose rows carry no ref/alt pair can never fill this
   section, and a heading permanently reading "not computed" says
   the opposite -- that a rebuild would fill it in (gain#1105).
   Filled by allele_score.jinja. #}
{% block alleles %}{% endblock %}

{# Empty by default: a kind with nothing to say here renders no section
   at all, rather than a heading that reads "not computed" forever.
   Filled by fragment_score.jinja. #}
{% block fragments %}{% endblock %}
{% endblock %}
