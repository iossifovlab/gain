{% extends base %}
{% block content %}

{% if data["PARS"] %}
<h3>Pseudoautosomal regions:</h3>
{% if data["PARS"]["X"] %}
<p>X chromosome:</p>
<ul>
{% for region in data["PARS"]["X"] %}
<li>{{region}}</li>
{% endfor %}
</ul>
{% endif %}

{% if data["PARS"]["Y"] %}
<p>Y chromosome: </p>
<ul>
{% for region in data["PARS"]["Y"] %}
<li>{{region}}</li>
{% endfor %}
</ul>
{% endif %}
{% endif %}

{% set statistics_missing = data["global_statistic"]["length"] is none %}
{% if statistics_missing %}
<p>Statistics not computed.</p>
{% endif %}

<h3>{{ "Chromosomes ({0}):".format(data["chromosomes"]|length) }}</h3>
<div class="scrollable-table-container">
    <table id="chromosomes-table">
        <thead>
            <tr>
                <th>Chrom</th>
                <th>Length</th>
                {% for nucleotide in ["A", "T", "C", "G", "N"] %}
                    <th>{{ nucleotide }}</th>
                {% endfor %}
            </tr>
            <tr>
                <th>Global</th>
                {% if statistics_missing %}
                <td></td>
                {% else %}
                <td>{{ '{:,}'.format(data["global_statistic"]["length"]) }}</td>
                {% endif %}
                {% for nucleotide in ["A", "T", "C", "G", "N"] %}
                    <td>{{ data["global_statistic"]["nucleotide_shares"].get(nucleotide, "") }}</td>
                {% endfor %}
            </tr>
        </thead>
        {%- for chrom, length in data["chromosomes"] -%}
            <tr>
                <td>{{ chrom }}</td>
                <td>{{ '{:,}'.format(length) }}</td>
                {% set shares = data["chrom_shares"].get(chrom, {}) %}
                {% for nucleotide in ["A", "T", "C", "G", "N"] %}
                    <td>{{ shares.get(nucleotide, "") }}</td>
                {% endfor %}
            </tr>
        {%- endfor -%}
    </table>
</div>
{% if not statistics_missing %}
    <h3>Bi-Nucleotide distribution:</h3>
    <table style="width: fit-content;">
        <tr>
            <th>{{ nucleotide }}</th>
            {% for nucleotide in ["A", "T", "C", "G", "N"] %}
                <th>{{ nucleotide }}</th>
            {% endfor %}
        </tr>
        {% for first_nucleotide in ["A", "T", "C", "G", "N"] %}
            <tr>
                <th>{{ first_nucleotide }}</th>
                {% for second_nucleotide in ["A", "T", "C", "G", "N"] %}
                    <td>{{ data["global_statistic"]["pair_shares"].get(first_nucleotide + second_nucleotide, "") }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </table>
{% endif %}
{% endblock %}
