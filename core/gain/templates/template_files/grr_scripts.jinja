    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script type="module">
        import sqlite3 from "https://cdn.jsdelivr.net/npm/@sqlite.org/sqlite-wasm@3.51.2-build6/dist/index.mjs";


        const start = async (sqlite3) => {
          const response = await fetch(new URL(`.CONTENTS.sqlite3.gz?v={{ sqlite3_hash }}`, document.baseURI))
          const ds = new DecompressionStream('gzip');
          const decompressedResponse = new Response(response.body.pipeThrough(ds));
          const arrayBuffer = await decompressedResponse.arrayBuffer()
          const p = await sqlite3.wasm.allocFromTypedArray(arrayBuffer)
          const db = new sqlite3.oo1.DB();
          let deserialize_flags = sqlite3.capi.SQLITE_DESERIALIZE_FREEONCLOSE;
          const rc = await sqlite3.capi.sqlite3_deserialize(db.pointer, 'main', p, arrayBuffer.byteLength, arrayBuffer.byteLength, deserialize_flags);
          await db.checkRc(rc);
          window.sqlite3 = db;
          window.sqlite3.query = (sql) => {
            const rows =  window.sqlite3.exec({sql: sql, returnValue: "resultRows"});
            console.log(`Executed query: ${sql}, got ${rows.length} rows`);
            console.log(rows);
            return rows;
          }
          // window.sqlite3.query = (sql) => {
          //  return window.sqlite3.exec({sql: sql, returnValue: "resultRows"})
          //}
        };

        const initializeSQLite = async () => {
          try {
            console.log('Loading and initializing SQLite3 module...');
            const sqlite3 = await sqlite3InitModule();
            console.log('Done initializing.');
            await start(sqlite3);
          } catch (err) {
            console.error('Initialization error:', err.name, err.message);
          }
        };


        function parseSizeToBytes(sizeStr) {
            const units = {
                'B': 1,
                'KB': 1024,
                'MB': 1024 * 1024,
                'GB': 1024 * 1024 * 1024,
                'TB': 1024 * 1024 * 1024 * 1024,
            };
            const match = sizeStr.match(/^([\d.]+)\s*([A-Z]+)$/);
            if (!match) return 0;
            const [, value, unit] = match;
            const multiplier = units[unit] || 1;
            return parseFloat(value) * multiplier;
        }

        const rowData = {}
        $(".contents > tbody > tr").each((index, row) => {
            const id = $(row).attr("id");
            const children = $(row).find("td");
            const sizeStr = children[3].textContent.trim();
            rowData[id] = {
                "type": children[0].textContent.trim(),
                "id": children[1].getElementsByTagName("a")[0].textContent.trim(),
                "version": children[2].textContent.trim(),
                "size": sizeStr,
                "sizeInBytes": parseSizeToBytes(sizeStr),
                "summary": children[4].textContent.trim(),
                "url": $(children[1].getElementsByTagName("a")[0]).attr("href").trim(),
            };
        })
        window.rowData = rowData;

        let sortColumn = 'none'; // 'none' | 'id' | 'type' | 'version' | 'summary'
        let sortOrder = 'none'; // 'none' | 'asc' | 'desc'
        let lastIds = [];

        function sortedIds(ids) {
            if (sortOrder === 'none' || sortColumn === 'none') return ids;
            const sorted = [...ids].sort((a, b) => {
                let aVal, bVal;
                let isNumeric = false;
                if (sortColumn === 'id') {
                    aVal = window.rowData[a].id;
                    bVal = window.rowData[b].id;
                } else if (sortColumn === 'type') {
                    aVal = window.rowData[a].type;
                    bVal = window.rowData[b].type;
                } else if (sortColumn === 'version') {
                    aVal = window.rowData[a].version;
                    bVal = window.rowData[b].version;
                } else if (sortColumn === 'size') {
                    aVal = window.rowData[a].sizeInBytes;
                    bVal = window.rowData[b].sizeInBytes;
                    isNumeric = true;
                } else if (sortColumn === 'summary') {
                    aVal = window.rowData[a].summary;
                    bVal = window.rowData[b].summary;
                }
                if (isNumeric) {
                    return aVal - bVal;
                }
                return aVal.localeCompare(bVal);
            });
            return sortOrder === 'desc' ? sorted.reverse() : sorted;
        }

        function applyRefreshData(ids) {
            lastIds = ids;
            refreshData(sortedIds(ids));
        }

        function UpdateStatus() {
            const status = $(`#status`);
            const statusError = $(`#status-error`);
            if (window.last_error) {
                statusError.show();
                statusError.text(`Query failed due to syntax error, debugging information is in the console.`);
            }
            else {
                statusError.text("");
                statusError.hide();
            }
            status.text(`${window.currentIds.length} resources`);
        }

        function refreshData(ids) {
            // Check both length and order so re-sorting the same set still re-renders.
            if (ids.length === (window.currentIds || []).length
                    && ids.every((id, i) => id === window.currentIds[i])) {
                UpdateStatus();
                return;
            }
            window.currentIds = ids;

            const rows = $(".contents > tbody > tr")
            rows.hide();
            for (const [index, rowId] of ids.entries()) {
                let row = $(rows[index]);
                let rowData = window.rowData[rowId];
                let cells = row.children("td");
                cells[0].textContent = rowData.type;
                cells[1].title = rowData.id;
                $(cells[1]).find("a").attr("href", rowData.url).text(rowData.id);
                $(cells[1]).children("div").children("span")[0].className = `material-symbols-outlined copy-icon ${rowData.id}`;
                cells[2].textContent = rowData.version;
                cells[3].textContent = rowData.size;
                cells[4].textContent = rowData.summary;
                cells[4].title = rowData.summary;
                row.show();
            }

            UpdateStatus();
        }

        window.dbLoaded = new Promise(async (resolve) => {
            await initializeSQLite()
            const all_ids_result = await window.sqlite3.query("SELECT full_id FROM contents;")
            window.all_ids = new Set(all_ids_result.map((row) => row[0]))
            const all_types_result = await window.sqlite3.query("SELECT DISTINCT type FROM contents ORDER BY type ASC;")
            const typeFilter = $("#type-filter");
            for (const row of all_types_result) {
                const type = row[0];
                const option = document.createElement("option");
                option.value = type;
                option.textContent = type;
                typeFilter.append(option);
            }
            applyRefreshData(Array.from(window.all_ids))

            resolve(window.sqlite3)
        });

        $(".loading").hide()

        $("#search-container").show()

        async function doSearch() {
            await window.dbLoaded;
            const searchValue = $("#search-field").val().trim();
            const typeFilter = $("#type-filter").val();
            if (searchValue === "" && typeFilter === "all") {
                window.last_error = null;
                applyRefreshData(Array.from(window.all_ids))
                return;
            }

            $(".searching").show()

            const ids = new Set();

            let query = "";;
            if (searchValue !== "" && typeFilter !== "all") {
                query = `SELECT full_id FROM contents WHERE contents MATCH '${searchValue}' AND type = '${typeFilter}'`
            }
            else if (searchValue !== "") {
                query = `SELECT full_id FROM contents WHERE contents MATCH '${searchValue}'`
            }
            else {
                query = `SELECT full_id FROM contents WHERE type = '${typeFilter}'`
            }

            window.last_error = null;
            try {
                const displayIds = window.sqlite3.query(query).map((row) => row[0]);
                applyRefreshData(displayIds);
            }
            catch (error) {
                window.last_error = error;
                console.error("Error during search:", error);
                applyRefreshData(Array.from(window.all_ids))
            }
            finally {
                $(".searching").hide()
            }
        }

        /*
         * The seam between the search and the module that owns the
         * address.
         *
         * The two are separate ES modules, so neither can see the other's
         * bindings; `window` is the only bridge this page has, and it
         * already carries several (`dbLoaded`, `rowData`, `all_ids`).
         * This is the first that has to work in *both* directions -- the
         * address is built from what the controls hold, and the controls
         * are filled from what the address says -- so it is one named
         * object rather than three more bare properties, and the other
         * module reaches for nothing in here except this.
         *
         * The empty string is "no type filter" across the seam, rather
         * than the "all" the markup gives the option: it makes "is
         * anything filtering?" the same question for both fields, and it
         * keeps the dropdown's sentinel from having to be spelled in the
         * address.
         */
        const searchChangeListeners = [];

        window.grrSearch = {
            /** What the controls hold right now. */
            current() {
                return {
                    q: $("#search-field").val().trim(),
                    type: $("#type-filter").val() === "all"
                        ? "" : $("#type-filter").val(),
                };
            },

            /** Put a search into the controls and run it. */
            async apply({ q, type }) {
                // Awaited because the type options are built from the
                // loaded index: setting the dropdown before that resolves
                // selects nothing at all -- the option is not there yet --
                // and does it silently. The term alone would not need the
                // wait, but filling one control and not the other leaves
                // the page showing a search nobody asked for.
                await window.dbLoaded;
                $("#search-field").val(q);
                $("#type-filter").val(type === "" ? "all" : type);
                await doSearch();
            },

            /** Call `listener` when the reader changes either control. */
            onChange(listener) {
                searchChangeListeners.push(listener);
            },
        };

        /*
         * Run what the controls now say, and tell the address about it.
         *
         * Every *reader-driven* entry point goes through here, and
         * `apply` deliberately does not: it is the address talking to the
         * controls, so announcing the change back would be answering its
         * own question.
         */
        function searchFromControls() {
            doSearch();
            for (const listener of searchChangeListeners) listener();
        }

        $("#type-filter").on("change", (e) => {
            searchFromControls();
        })

        function debounce(func, wait, immediate) {
            var timeout;
            return function() {
                var context = this, args = arguments;
                var later = function() {
                    timeout = null;
                    if (!immediate) func.apply(context, args);
                };
                var callNow = immediate && !timeout;
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
                if (callNow) func.apply(context, args);
            };
        };

        var debouncedSearch = debounce(searchFromControls, 400, false);

        $("#search-field").on("keydown", (e) => {
          if (e.key === "Enter") {
            searchFromControls();
          }
          else {
            debouncedSearch();
          }
          // reset all icons
           document.querySelectorAll('.copy-icon').forEach(i => i.textContent = 'content_copy')
        });
        
        $(".copy-icon").on("click", (e) => {
          navigator.clipboard.writeText(e.target.classList[2]).then(
            () => {
              // reset all icons
              document.querySelectorAll('.copy-icon').forEach(i => i.textContent = 'content_copy')
              e.target.textContent = 'check'
              setTimeout(function(){
                e.target.textContent = 'content_copy'
              }, 3000);
            }
          )
        });

        const sortableColumns = {
            'id-col-header': 'id',
            'type-col-header': 'type',
            'version-col-header': 'version',
            'size-col-header': 'size',
            'summary-col-header': 'summary'
        };

        const sortIcons = { none: 'unfold_more', asc: 'arrow_upward', desc: 'arrow_downward' };

        function updateSortIndicators() {
            Object.entries(sortableColumns).forEach(([headerId, colName]) => {
                const indicator = document.getElementById(colName + '-sort-indicator');
                indicator.textContent = sortColumn === colName ? sortIcons[sortOrder] : sortIcons['none'];
            });
        }

        Object.entries(sortableColumns).forEach(([headerId, colName]) => {
            document.getElementById(headerId).addEventListener('click', (e) => {
                if (e.target.closest('.col-resizer')) return;
                if (sortColumn === colName) {
                    sortOrder = sortOrder === 'none' ? 'asc' : sortOrder === 'asc' ? 'desc' : 'none';
                } else {
                    sortColumn = colName;
                    sortOrder = 'asc';
                }
                updateSortIndicators();
                refreshData(sortedIds(lastIds));
            });
        });

    </script>
    <script type="module">
        // ---- Hierarchical (tree) view ----
        // Builds a folder tree from the '/'-separated resource full ids in
        // window.rowData (populated synchronously by the script above) and
        // renders it as an alternative to the flat table.
        (function () {
            const rowData = window.rowData || {};

            // Mirror gain.utils.helpers.convert_size so aggregated folder
            // sizes are formatted the same way as the per-resource sizes.
            function formatSize(bytes) {
                if (!bytes) return "0B";
                const suffix = ["B", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
                const exp = Math.floor(Math.log(bytes) / Math.log(1024));
                const size = Math.round(bytes / Math.pow(1024, exp) * 100) / 100;
                // convert_size interpolates a rounded float, so an integral
                // magnitude keeps a decimal place ("2.0 GB"). String() drops
                // it, which would print folder sizes in a different format
                // from the resource sizes listed beside them.
                const text = Number.isInteger(size)
                    ? size.toFixed(1)
                    : String(size);
                return text + " " + suffix[exp];
            }

            function escapeHtml(value) {
                return String(value == null ? "" : value).replace(/[&<>"']/g, (c) => ({
                    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
                }[c]));
            }

            function makeNode(name, path) {
                // `children` has no prototype, so the only names in it are
                // folders that were put there. A plain `{}` answers
                // `children["constructor"]` -- and `"toString"`, and
                // `"__proto__"` -- out of `Object.prototype`, which since
                // the folder path became addressable (#579) is a name a
                // reader can put in the URL: the lookup would accept a
                // folder that does not exist and then hand the renderer a
                // function to read children off.
                return {
                    name, path, children: Object.create(null),
                    resources: [], count: 0, bytes: 0,
                };
            }

            const root = makeNode("All resources", []);
            for (const fullId of Object.keys(rowData)) {
                const parts = fullId.split("/");
                let node = root;
                for (let i = 0; i < parts.length - 1; i++) {
                    const seg = parts[i];
                    if (!node.children[seg]) {
                        node.children[seg] = makeNode(seg, parts.slice(0, i + 1));
                    }
                    node = node.children[seg];
                }
                node.resources.push({
                    name: parts[parts.length - 1], fullId, data: rowData[fullId],
                });
            }

            // Precompute recursive resource count + total size for every folder.
            (function aggregate(node) {
                let count = node.resources.length;
                let bytes = node.resources.reduce((s, r) => s + (r.data.sizeInBytes || 0), 0);
                for (const key of Object.keys(node.children)) {
                    aggregate(node.children[key]);
                    count += node.children[key].count;
                    bytes += node.children[key].bytes;
                }
                node.count = count;
                node.bytes = bytes;
            })(root);

            /**
             * How far down `path` the tree actually goes.
             *
             * Returns the deepest folder it could reach and the segments
             * that reached it -- which is the whole answer, because the two
             * callers want opposite halves of it: the renderer wants the
             * folder, and the applier wants the path to put in the address.
             *
             * One walk rather than one per caller, so the rule for
             * resolving a segment to a child lives in one place. That rule
             * is not as dull as it looks: `children` is prototype-less
             * precisely so this lookup cannot answer with something
             * inherited, and a second copy of the walk is somewhere for the
             * next such rule to be applied to only half the callers.
             *
             * Stopping short is ordinary rather than exceptional. Folders
             * are a shape derived from the resource ids the page was
             * generated with, and a repository is regenerated whenever its
             * content changes, so an address routinely outlives the folder
             * it names. Walking up leaves the reader on the deepest part of
             * their address that still means something; "no surviving
             * ancestor" is the root, the same answer with nothing left.
             */
            function descend(path) {
                let node = root;
                const reached = [];
                for (const seg of path) {
                    const child = node.children[seg];
                    if (!child) break;
                    node = child;
                    reached.push(seg);
                }
                return { node, reached };
            }

            // `localeCompare`, which is what the table's sorter uses. `<`
            // and `>` compare UTF-16 code units, so every capitalised name
            // sorted ahead of every lowercase one and a repository mixing
            // the two was listed in one order by the table and another by
            // the tree (gain#564).
            const byName = (a, b) => a.name.localeCompare(b.name);

            const breadcrumbEl = document.getElementById("breadcrumb");
            const listEl = document.getElementById("hierarchical-list");
            let currentPath = [];

            function renderBreadcrumb() {
                breadcrumbEl.innerHTML = "";
                const crumbs = [{ name: "All resources", path: [] }];
                currentPath.forEach((seg, i) => {
                    crumbs.push({ name: seg, path: currentPath.slice(0, i + 1) });
                });
                crumbs.forEach((crumb, i) => {
                    if (i > 0) {
                        const sep = document.createElement("span");
                        sep.className = "breadcrumb-sep";
                        sep.textContent = "/";
                        breadcrumbEl.appendChild(sep);
                    }
                    const isLast = i === crumbs.length - 1;
                    const el = document.createElement(isLast ? "span" : "a");
                    el.textContent = crumb.name;
                    el.className = "breadcrumb-item" + (isLast ? " current" : "");
                    if (!isLast) {
                        el.href = "#";
                        el.addEventListener("click", (e) => {
                            e.preventDefault();
                            goTo({
                                view: "hierarchical",
                                path: crumb.path,
                            });
                        });
                    }
                    breadcrumbEl.appendChild(el);
                });
            }

            function renderList() {
                // Always a folder: `currentPath` is only ever assigned what
                // `descend` reached, so there is no "no such folder" case
                // left here to guard against. A guard would be worse than
                // none -- the list has already been emptied by this point,
                // so bailing would show an empty folder and say nothing,
                // which is where a broken invariant would hide.
                const { node } = descend(currentPath);
                listEl.innerHTML = "";

                for (const folder of Object.values(node.children).sort(byName)) {
                    const row = document.createElement("div");
                    row.className = "hv-row hv-folder";
                    row.innerHTML =
                        '<span class="material-symbols-outlined hv-icon">folder</span>'
                        + '<div class="hv-main">'
                        + '<span class="hv-name">' + escapeHtml(folder.name) + "</span>"
                        + '<span class="hv-count">(' + folder.count + ")</span>"
                        + "</div>"
                        + '<span class="hv-size">' + escapeHtml(formatSize(folder.bytes)) + "</span>";
                    row.addEventListener("click", () => goTo({
                        view: "hierarchical",
                        path: folder.path,
                    }));
                    listEl.appendChild(row);
                }

                for (const res of [...node.resources].sort(byName)) {
                    const d = res.data;
                    const meta = [
                        d.type,
                        // get_version_str() renders an unversioned resource
                        // as "0", which is truthy — version 0 means absent.
                        d.version && d.version !== "0"
                            ? "v" + d.version
                            : null,
                        d.summary,
                    ].filter(Boolean).join(" · ");
                    const row = document.createElement("div");
                    row.className = "hv-row hv-resource";
                    row.innerHTML =
                        '<span class="material-symbols-outlined hv-icon">description</span>'
                        + '<div class="hv-main">'
                        + '<a class="hv-name hv-link" href="' + escapeHtml(d.url) + '">'
                        + escapeHtml(res.name) + "</a>"
                        + '<span class="hv-meta" title="' + escapeHtml(meta) + '">' + escapeHtml(meta) + "</span>"
                        + "</div>"
                        + '<span class="hv-size">' + escapeHtml(d.size) + "</span>";
                    listEl.appendChild(row);
                }

                if (!Object.keys(node.children).length && !node.resources.length) {
                    const empty = document.createElement("div");
                    empty.className = "hv-empty";
                    empty.textContent = "No resources";
                    listEl.appendChild(empty);
                }
            }

            function navigateTo(path) {
                currentPath = path;
                renderBreadcrumb();
                renderList();
            }

            // ---- View toggle ----
            const tableBtn = document.getElementById("table-view-btn");
            const hierBtn = document.getElementById("hierarchical-view-btn");
            const tableWrapper = document.getElementById("table-wrapper");
            const hierWrapper = document.getElementById("hierarchical-wrapper");
            const searchContainer = document.getElementById("search-container");
            const searchField = document.getElementById("search-field");
            const typeFilter = document.getElementById("type-filter");
            const statusEl = document.getElementById("status");

            function setView(view) {
                const isHier = view === "hierarchical";
                hierBtn.classList.toggle("active", isHier);
                tableBtn.classList.toggle("active", !isHier);
                tableWrapper.style.display = isHier ? "none" : "";
                hierWrapper.style.display = isHier ? "" : "none";
                if (statusEl) statusEl.style.display = isHier ? "none" : "";
                // Search + type filter are table-view only.
                searchField.disabled = isHier;
                typeFilter.disabled = isHier;
                searchContainer.classList.toggle("disabled", isHier);
                // Which chrome to show, and nothing else. *What* the tree
                // shows depends on resolving a folder, which the applier
                // does -- so "is this the tree?" is asked in one place
                // rather than here and again on either side of the call.
            }

            // ---- Browse state lives in the URL hash ----
            // The address is the single source of truth for which view is
            // showing. `#/` is the tree; no fragment at all is the table.
            // The buttons below only ever *push* a new address -- what to
            // render is decided in one place, from what the address says,
            // so a click, a reload, a bookmark and the browser's Back all
            // arrive through the same path instead of three of them being
            // special cases of the fourth.
            //
            // The state is a record rather than a bare view string
            // because it carries more than the view: the folder path
            // (#579) and the search term and type filter (#1331), each of
            // which extends these two functions rather than re-reading the
            // hash somewhere else.

            const HIERARCHICAL_HASH = "#/";

            /** The browse state a fragment addresses. */
            function parseHash(hash) {
                // The search is split off before anything else looks at
                // the fragment, because the path is split on "/" and would
                // otherwise resolve a folder literally named
                // "scores?q=phast". The first "?" is unambiguously the
                // separator: `encodeURIComponent` escapes a "?" inside a
                // segment to "%3F", so a raw one cannot have come from a
                // folder name.
                const cut = hash.indexOf("?");
                const address = cut < 0 ? hash : hash.slice(0, cut);
                const search = cut < 0 ? "" : hash.slice(cut + 1);
                const { q, type } = parseSearch(search);
                // Anything unrecognised reads as the default rather than
                // raising: a hand-edited or stale link must still open the
                // page, and a fragment is also how something with no
                // interest in this page at all -- a link into the docs, a
                // tracker's leftovers -- ends up in the address.
                if (!address.startsWith(HIERARCHICAL_HASH)) {
                    return { view: "table", path: [], q, type };
                }
                return {
                    view: "hierarchical",
                    path: parsePath(address.slice(HIERARCHICAL_HASH.length)),
                    q,
                    type,
                };
            }

            /** The search a fragment's query part names. */
            function parseSearch(encodedSearch) {
                const search = { q: "", type: "" };
                for (const pair of encodedSearch.split("&")) {
                    if (pair === "") continue;
                    const eq = pair.indexOf("=");
                    if (eq < 0) continue;
                    const name = pair.slice(0, eq);
                    if (!(name in search)) continue;
                    try {
                        search[name] = decodeURIComponent(pair.slice(eq + 1));
                    } catch {
                        // Malformed escape ("%zz"), which a hand-edited or
                        // truncated address can carry. The field is left
                        // empty rather than the load abandoned -- the same
                        // choice `parsePath` makes, for the same reason.
                        search[name] = "";
                    }
                }
                return search;
            }

            /** The folder segments a fragment's path names, outermost first. */
            function parsePath(encodedPath) {
                const segments = [];
                for (const encoded of encodedPath.split("/")) {
                    // An empty segment names no folder -- a trailing or a
                    // doubled slash -- so it is dropped rather than looked
                    // up as a child called "".
                    if (encoded === "") continue;
                    let segment;
                    try {
                        segment = decodeURIComponent(encoded);
                    } catch {
                        // `decodeURIComponent` throws on a malformed escape
                        // ("%zz"), which a hand-edited or truncated address
                        // can carry. What decoded so far is kept and the
                        // rest abandoned, which leaves a shorter path --
                        // and a path naming a folder that is not there is
                        // what the walk-up already exists for, since
                        // folders come and go between regenerations. One
                        // route for a path that cannot be followed, not two.
                        return segments;
                    }
                    segments.push(segment);
                }
                return segments;
            }

            /**
             * The fragment addressing a state; "" for the bare default.
             *
             * A pure function of what it is handed, and it has to stay
             * one. `goTo`'s no-op guard works by round-tripping the
             * *current* address through the parser and back through here
             * and comparing; a build that read the live controls instead
             * of its argument would stop reproducing the address it was
             * given, and the guard would push entries that change nothing
             * -- the exact symptom it exists to prevent. Callers read the
             * controls and put the answer in the state.
             */
            function buildHash(state) {
                const search = buildSearch(state);
                if (state.view !== "hierarchical") {
                    // The table's address is the query alone, so with no
                    // search there is nothing to say and the fragment goes
                    // away entirely.
                    return search === "" ? "" : "#?" + search;
                }
                return buildPath(state) + (search === "" ? "" : "?" + search);
            }

            /** The query part addressing a state's search; "" when unset. */
            function buildSearch(state) {
                const pairs = [];
                // A fixed order, so that one search has one address: the
                // round trip above compares strings, and two spellings of
                // the same state would make the guard miss.
                if (state.q) pairs.push("q=" + encodeURIComponent(state.q));
                if (state.type) {
                    pairs.push("type=" + encodeURIComponent(state.type));
                }
                return pairs.join("&");
            }

            /** The path part addressing a hierarchical state. */
            function buildPath(state) {
                // Encoded per segment and then joined, never the other way
                // round: the segments are resource id fragments, which are
                // untrusted repository content (gain#467, gain#528), and
                // encoding the joined string would escape the separators
                // along with everything else.
                //
                // Every character a resource id may legally carry is
                // unreserved here, so for a repository this scanner built
                // the encoding is the identity: enumerating one matches its
                // ids against `[a-zA-Z0-9/._-]+` and refuses the rest. It
                // is kept for the ids this page did *not* vet -- a remote
                // `.CONTENTS` is read verbatim -- and because that grammar
                // widening should not silently become a way to write the
                // separator. Going per segment is also
                // what makes a name containing "/" impossible to spell --
                // it comes back as one folder, not two.
                return HIERARCHICAL_HASH
                    + state.path.map(encodeURIComponent).join("/");
            }

            /** Render what the current address says. The only applier. */
            function applyHash() {
                const { view, path, q, type } = parseHash(location.hash);
                setView(view);
                applySearch(q, type);
                // The table has no folder to resolve and no address of its
                // own to canonicalise -- see `canonicalise` for why
                // rewriting it would be actively wrong -- so this is where
                // the tree's half of the work begins and ends.
                if (view !== "hierarchical") return;
                const { reached } = descend(path);
                navigateTo(reached);
                canonicalise(reached);
            }

            /**
             * Put the address's search into the controls, if it is news.
             *
             * The applier runs on every address change, not only on the
             * way in: `goTo` calls it after pushing, and Back and Forward
             * reach it through `hashchange`. Applying unconditionally
             * would therefore re-run the search on every move between
             * folders, which is a query and a re-render for an answer the
             * page is already showing.
             *
             * Comparing against what the controls hold is also what makes
             * the arriving load apply exactly once, without a separate
             * "have I done this yet?" flag: after the first application
             * the controls agree with the address, so the next call is a
             * no-op by the same test.
             */
            function applySearch(q, type) {
                const current = window.grrSearch.current();
                if (current.q === q && current.type === type) return;
                window.grrSearch.apply({ q, type });
            }

            /**
             * Make the address agree with what was just rendered.
             *
             * A walked-up path, a dropped empty segment and a decoded
             * escape all leave the address saying something other than the
             * folder now on screen, and that costs twice over. The URL the
             * reader can copy out of the bar names a folder they are not
             * looking at. And `goTo`'s no-op guard compares *parsed*
             * addresses, knowing nothing about any of this, so it sees a
             * difference where there is none on screen: the button for the
             * view already showing would push an entry that changes
             * nothing, and the Back after it would appear to do nothing --
             * the exact symptom that guard exists to prevent.
             *
             * `replaceState`, so the resolved address takes the place of
             * the one it resolves rather than being stacked on top of it:
             * Back still leads out of the page, and an address that could
             * not be followed cannot be returned to by going back to it.
             *
             * Called for the hierarchical view only, which is why it takes
             * no view: the table's canonical address is "", so rewriting
             * *its* address would silently delete a fragment belonging to
             * whatever put it there -- someone's deep link into a section.
             * Arriving at the table is not consent to discard it, the same
             * rule `goTo` follows.
             *
             * The boundary is really the `#/` namespace rather than the
             * view, and this page claims all of it (#578): `#/docs/intro`
             * is read as a tree path, salvages nothing, and is rewritten to
             * `#/` -- where before this it was merely ignored. Narrowing
             * that by skipping the rewrite when nothing was salvaged is not
             * available, because `#/nonesuch/deeper` resolving to `#/` is
             * exactly what the stale-path behaviour asks for.
             */
            function canonicalise(path) {
                const hash = buildHash({ view: "hierarchical", path });
                // Never "" for this view, so there is no "cannot express a
                // bare path" case to handle as `goTo` has to.
                if (hash !== location.hash) {
                    history.replaceState(null, "", hash);
                }
            }

            /** Push `state` into the session history, then render it. */
            function goTo(state) {
                const hash = buildHash(state);
                // Nothing to do when the address already means this. That
                // stops the button already active from stacking a history
                // entry that changes nothing -- Back would then appear not
                // to work.
                //
                // Compared as *canonical addresses*, which is why the
                // current one is put through the parser and back out
                // again. Two cheaper-looking forms are both wrong. Raw
                // `hash === location.hash` misreads every fragment this
                // page does not recognise: at `#section-2` the table is
                // already showing, but "" is not "#section-2", so the
                // table button would push a dead entry and discard a
                // fragment belonging to whatever put it there -- and
                // clicking a view is not consent to discard it. Comparing
                // one named field (`.view`) is right today and rots the
                // moment there is a second field: #579 puts the folder
                // path in this same state, and a guard that reads only
                // the view would swallow every move between folders
                // while the tree is already showing, leaving Back with
                // nothing to walk back through. Round-tripping through
                // `buildHash` compares whatever the state currently is.
                if (buildHash(parseHash(location.hash)) === hash) return;
                // `pushState` rather than assigning `location.hash`, which
                // cannot express "no fragment" -- clearing it leaves a bare
                // "#" in the address bar. The cost is that it fires no
                // event of its own, so the applier is called here;
                // Back and Forward *do* fire `hashchange` (measured, not
                // assumed) and reach it through the listener below.
                history.pushState(
                    null, "", hash || location.pathname + location.search);
                applyHash();
            }

            // The tree button carries the folder showing at the time it is
            // clicked, so that leaving the tree for the table and coming
            // back lands where the reader left rather than at the root.
            // `currentPath` is [] until the tree has been entered, which is
            // why a first click on it addresses the root; it survives the
            // visit to the table because only the hierarchical branch of
            // the applier reassigns it.
            //
            // The table button carries no folder, because the table has no
            // address to put one in.
            tableBtn.addEventListener("click", () => goTo({ view: "table" }));
            hierBtn.addEventListener("click", () => goTo(
                { view: "hierarchical", path: currentPath }));

            // Editing a control *replaces* the current entry rather than
            // pushing one. The search is debounced, so pushing would leave
            // a six-letter term as six Back stops between the reader and
            // wherever they came from -- Back has to lead out of the
            // search, not crawl back through it a keystroke at a time.
            //
            // `replaceState` fires neither `hashchange` nor `popstate`,
            // which is what makes this cheap: writing the address here
            // cannot re-enter the applier and re-run the search that has
            // just run. That is load-bearing rather than incidental.
            //
            // The rest of the state is read back out of the address, so
            // that a search typed while the tree is showing keeps the
            // folder it was typed in.
            window.grrSearch.onChange(() => {
                const hash = buildHash({
                    ...parseHash(location.hash),
                    ...window.grrSearch.current(),
                });
                if (hash === location.hash) return;
                history.replaceState(
                    null, "", hash || location.pathname + location.search);
            });

            // `hashchange` only. A same-document fragment move fires
            // `popstate` as well, and listening to both would apply every
            // traversal twice.
            window.addEventListener("hashchange", applyHash);

            // Pre-render the tree so switching views is instant -- unless
            // the address is already asking for it, in which case the
            // applier below renders it on the way in and doing it here
            // would build the same root twice before anything is shown.
            // That is exactly the bookmarked/shared/reloaded `#/` load
            // this feature exists to serve, so it is the one case worth
            // not doing twice.
            if (parseHash(location.hash).view !== "hierarchical") {
                renderBreadcrumb();
                renderList();
            }

            // Arriving is the same operation as moving: the address may
            // already name a view, and this is the only thing that reads it.
            applyHash();
        })();
    </script>
    <script type="module">
        const table = document.getElementById('resource-table');
        const cols = Array.from(table.querySelectorAll('colgroup col'));
        const ths = Array.from(table.querySelectorAll('thead th'));

        // Proportionally rescale all columns when the wrapper changes size.
        // Col widths start as inline CSS percentages, so colTotal is 100 on the
        // first observation and the percentages are converted to pixels there.
        const wrapper = document.getElementById('table-wrapper');
        const wrapperObserver = new ResizeObserver(() => {
          const newWidth = table.clientWidth;
          const colTotal = cols.reduce((s, c) => s + parseInt(c.style.width, 10), 0);
          // Bail on a zero measurement: hiding the wrapper (the hierarchical
          // view does) fires the observer with clientWidth 0, and scaling by 0
          // would zero every col permanently — colTotal would then be 0 too, so
          // the guard below would return early forever and never recover.
          // Guard < 2px to avoid an infinite loop: writing col widths can itself
          // trigger the observer.
          if (!newWidth || !colTotal || Math.abs(newWidth - colTotal) < 2) return;
          const scale = newWidth / colTotal;
          cols.forEach(c => { c.style.width = Math.round(parseInt(c.style.width, 10) * scale) + 'px'; });
        });
        wrapperObserver.observe(wrapper);

        // A synchronous inline script sets the initial height before first paint;
        // this observer keeps it correct when rows are filtered in/out.
        const resizers = Array.from(table.querySelectorAll('.col-resizer'));
        function updateResizerHeights() {
          const h = table.offsetHeight + 'px';
          resizers.forEach(r => { r.style.height = h; });
        }
        updateResizerHeights();
        const tableObserver = new ResizeObserver(updateResizerHeights);
        tableObserver.observe(table);

        let pixelWidthsInitialized = false;

        const dragLine = document.createElement('div');
        dragLine.id = 'col-drag-line';
        document.body.appendChild(dragLine);

        const MIN_WIDTH = 85;

        ths.forEach((th, i) => {
          const resizer = th.querySelector('.col-resizer');
          if (!resizer) return;

          resizer.addEventListener('mousedown', (e) => {
            // Convert CSS percentage col widths to pixels on first drag so the
            // wrapperObserver and drag deltas work in consistent pixel units.
            if (!pixelWidthsInitialized) {
              ths.forEach((t, idx) => { cols[idx].style.width = t.offsetWidth + 'px'; });
              pixelWidthsInitialized = true;
            }

            const startWidths = cols.map(c => parseInt(c.style.width, 10));
            const startX = e.clientX;

            // Cascade bounds: sum shrinkable space across all cols in each direction.
            let rightRoom = 0;
            for (let j = i + 1; j < cols.length; j++) {
              rightRoom += Math.max(0, startWidths[j] - MIN_WIDTH);
            }
            let leftRoom = 0;
            for (let j = i; j >= 0; j--) {
              leftRoom += Math.max(0, startWidths[j] - MIN_WIDTH);
            }
            const minX = startX - leftRoom;
            const maxX = startX + rightRoom;

            resizer.classList.add('resizing');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            table.style.pointerEvents = 'none';
            const wrapperRect = wrapper.getBoundingClientRect();
            dragLine.style.top = wrapperRect.top + 'px';
            dragLine.style.height = wrapperRect.height + 'px';
            dragLine.style.transform = 'translateX(' + e.clientX + 'px)';
            dragLine.style.display = 'block';

            const onMouseMove = (ev) => {
              dragLine.style.transform = 'translateX(' + Math.min(maxX, Math.max(minX, ev.clientX)) + 'px)';
            };

            const onMouseUp = (ev) => {
              dragLine.style.display = 'none';
              resizer.classList.remove('resizing');
              document.body.style.cursor = '';
              document.body.style.userSelect = '';
              table.style.pointerEvents = '';
              document.removeEventListener('mousemove', onMouseMove);
              document.removeEventListener('mouseup', onMouseUp);

              const delta = Math.min(maxX, Math.max(minX, ev.clientX)) - startX;
              const newWidths = [...startWidths];

              if (delta > 0) {
                // Dragging right: col[i] grows, right cols shrink one by one.
                let toTake = delta;
                for (let j = i + 1; j < cols.length && toTake > 0; j++) {
                  const taken = Math.min(toTake, startWidths[j] - MIN_WIDTH);
                  newWidths[j] = startWidths[j] - taken;
                  toTake -= taken;
                }
                newWidths[i] = startWidths[i] + (delta - toTake);
              } else if (delta < 0) {
                // Dragging left: left cols shrink one by one, col[i+1] grows.
                let toTake = -delta;
                for (let j = i; j >= 0 && toTake > 0; j--) {
                  const taken = Math.min(toTake, startWidths[j] - MIN_WIDTH);
                  newWidths[j] = startWidths[j] - taken;
                  toTake -= taken;
                }
                if (i + 1 < cols.length) {
                  newWidths[i + 1] = startWidths[i + 1] + (-delta - toTake);
                }
              }

              cols.forEach((c, j) => { c.style.width = newWidths[j] + 'px'; });
            };

            // Listeners on document, not the handle, so dragging outside the
            // element doesn't break the interaction.
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
            // Prevent text selection while dragging.
            e.preventDefault();
          });
        });
    </script>
