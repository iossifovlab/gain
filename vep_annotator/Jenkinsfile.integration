// Dedicated Jenkins pipeline for the gain-vep-annotator integration
// test suite. Builds the regular vep_annotator CI image, provisions a
// persistent VEP cache on the agent (under the agent home,
// ${HOME}/vep_cache), and runs pytest against the real VEP stack —
// `VEPCacheAnnotator.run` spawns `ensemblorg/ensembl-vep:<version>`
// containers via the host docker daemon.
//
// The job also owns the gain-vep-annotator conda package (#1601): the last
// stage builds it from the upstream root build's archived wheel and
// verifies it from the agent-local package cache. The root pipeline builds
// only gain-core and gain-demo-annotator; it triggers this job on master
// when vep_annotator/**, conda-builder/** or core/conda-recipe/** changes.
//
// Expected Jenkins job setup:
//   - Script path: vep_annotator/Jenkinsfile.integration
//   - Point at any branch that carries the vep_annotator sub-project.
//
// DinD path alignment: every path that can end up as a Docker volume
// source (pytest tmp_path, the VEP cache) is bind-mounted at the same
// absolute path in the CI test container and on the host.

// Zulip failure alert (seqpipe/infra#105). Builds that pass say nothing.
//
// `build-status` used to receive a "Started build" message *and* a result
// message for every build of every job — 827 messages in 48h, of which 10 were
// failures — which made it unreadable, so nobody read it. Only FAILURE and
// UNSTABLE alert now, and they tag the channel so the alert actually pushes.
//
// UNSTABLE is included deliberately: ruff/mypy/pylint gate to UNSTABLE rather
// than FAILURE, so a failure-only rule would let a lint regression sit silent
// until the 09:00 digest (seqpipe/infra#110).
//
// Verbatim copy of the block proven in #809 — do not re-derive it.
def zulipAlert(String status, String emoji) {
    String suffix = ''
    try {
        def results = currentBuild.rawBuild.getAction(
            hudson.tasks.test.AbstractTestResultAction)
        if (results != null) {
            // failCount == 0 on a red build means nothing got as far as
            // failing a test — a teardown / sidecar / agent problem rather
            // than a code break. Saying which is what decides "re-run" vs
            // "investigate" without opening Jenkins.
            suffix = results.failCount > 0
                ? " — ${results.failCount} test(s) failed"
                : ' — no failing tests (infra/teardown)'
        }
    } catch (ignored) {
        // getAction() needs a one-time In-process Script Approval
        // (seqpipe/infra#106). Until that lands the alert still fires, just
        // without the count: the reporting must never break the report.
        suffix = ''
    }
    return "@**channel** ${emoji} " +
        "[${env.JOB_NAME} ${currentBuild.displayName}](${env.BUILD_URL}) " +
        "${status}${suffix}"
}

pipeline {
    // Pinned to `pooh`: the multi-GB VEP cache under ${HOME}/vep_cache
    // is maintained on that agent and reused across builds.
    agent { label 'pooh' }

    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // The shared cache dir + the single ensembl-vep image pull can
        // race across concurrent runs; serialise builds on the agent.
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'UPSTREAM_PROJECT',
            defaultValue: '',
            description: 'Root gain build job whose archived vep wheel and ' +
                'gain-core .conda the Conda package stage uses. Empty = ' +
                'iossifovlab/gain/master.',
        )
        string(
            name: 'UPSTREAM_BUILD',
            defaultValue: '',
            description: 'Build number of UPSTREAM_PROJECT. Empty = its last ' +
                'successful build.',
        )
    }

    // tb-7e7: cron lives in vep_annotator/jenkins-jobs/integration.groovy
    // (the Job DSL), not here. A `triggers { cron(...) }` block in this
    // Jenkinsfile only registers AFTER the pipeline runs once, and
    // gain-seed re-applies the DSL on every master push — wiping the
    // registration. Putting the cron in the DSL means each seed run
    // re-asserts it explicitly.

    environment {
        // Persistent across builds — the VEP cache is multi-GB and
        // mostly reused (`install_vep_cache --continue`). Anchored to the
        // agent home (on pooh, /var/lib/jenkins/vep_cache -> ZFS via the
        // home symlink) rather than a hardcoded /data mount, which was
        // remounted read-only and is destroyed by the pooh /data->ZFS
        // migration (seqpipe/infra Phase 2). See gain#188.
        //
        // DinD path alignment: this same absolute path is the docker
        // volume *source* for the nested ensembl-vep container spawned by
        // the host daemon (VEPCacheAnnotator, via cache_dir), so it must
        // be identical on the host, inside the CI test container, and in
        // the integration fixture's `cache_dir`. Keep
        // integration_tests/vep_full_annotator/annotation.yaml in lockstep
        // with this value.
        VEP_CACHE_DIR = "${env.HOME}/vep_cache"
        // `gain-vep-integration-ci`, not `gain-vep-annotator-ci`: the
        // latter is what the root Jenkinsfile's runProject() builds for
        // the vep_annotator sub-project, and the root pipeline *triggers*
        // this job — so the two run concurrently and both `docker rmi`
        // the name in cleanup, on independent build counters (#478).
        // Matches the naming its sibling integration jobs already use
        // (gain-core-integration-ci, gain-spliceai-integration-ci).
        IMAGE_TAG = "gain-vep-integration-ci:${env.BUILD_NUMBER}"
        CONDA_BUILDER_TAG = "gain-conda-builder-ci:vep-integration-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Prepare workspace') {
            steps {
                sh 'rm -rf reports && mkdir -p reports/integration'
            }
        }

        stage('Build image') {
            steps {
                sh '''
                    docker build -f vep_annotator/Dockerfile \
                        -t ${IMAGE_TAG} .
                '''
            }
        }

        stage('Provision VEP cache') {
            steps {
                sh '''
                    # DinD path alignment (gain#188): the integration fixture's
                    # cache_dir is the host docker volume *source* for the nested
                    # ensembl-vep container, so it must equal VEP_CACHE_DIR. Fail
                    # fast with a clear message if the two ever drift, instead of
                    # a cryptic read-only/wget error deep in the VEP run.
                    fixture=vep_annotator/integration_tests/vep_full_annotator/annotation.yaml
                    fixture_cache_dir=$(sed -n 's/^[[:space:]]*cache_dir:[[:space:]]*//p' "${fixture}")
                    if [ "${fixture_cache_dir}" != "${VEP_CACHE_DIR}" ]; then
                        echo "cache_dir mismatch: ${fixture} has '${fixture_cache_dir}', expected '${VEP_CACHE_DIR}'" >&2
                        echo "Keep ${fixture} in lockstep with VEP_CACHE_DIR (see gain#188)." >&2
                        exit 1
                    fi

                    mkdir -p "${VEP_CACHE_DIR}"
                    docker run --rm \
                        -v "${VEP_CACHE_DIR}:${VEP_CACHE_DIR}" \
                        ${IMAGE_TAG} \
                        install_vep_cache "${VEP_CACHE_DIR}" --force --continue
                '''
            }
        }

        stage('Integration tests') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v /tmp:/tmp \
                        -v ${VEP_CACHE_DIR}:${VEP_CACHE_DIR} \
                        -v $PWD/reports/integration:/reports \
                        ${IMAGE_TAG} \
                        sh -c '
                            set +e
                            pytest -v \
                                integration_tests/ \
                                --junitxml=/reports/pytest.xml
                            chmod -R a+rw /reports
                            exit 0
                        '
                '''
            }
        }

        stage('Conda package') {
            // Builds the gain-vep-annotator conda package with `--test skip`
            // and runs the recipe's install checks from the agent-local
            // package cache (#1601). The root pipeline builds only
            // gain-core and gain-demo-annotator; this job owns the vep
            // package.
            //
            // Inputs are the upstream root build's archived vep wheel and
            // gain-core .conda. Deliberately the LAST stage: the root
            // pipeline triggers this job from its final stages and only
            // archives in `post`, so the stages above are the margin for
            // the parent to finish (the gain-conda-integration precedent).
            // Nightly and manual runs, with no UPSTREAM_BUILD, take the last
            // successful iossifovlab/gain/master build. The recipe comes
            // from this job's master checkout, the wheel from that build.
            steps {
                script {
                    String project = params.UPSTREAM_PROJECT?.trim() ?:
                        'iossifovlab/gain/master'
                    def selector = params.UPSTREAM_BUILD?.trim()
                        ? specific(params.UPSTREAM_BUILD)
                        : lastSuccessful()
                    echo "Copying the vep wheel and gain-core .conda " +
                         "from ${project} " +
                         "(build ${params.UPSTREAM_BUILD ?: 'lastSuccessful'})"
                    sh 'rm -rf dist conda'
                    copyArtifacts(
                        filter: 'dist/vep_annotator/*.whl, ' +
                            'dist/conda/gain-core-*.conda',
                        fingerprintArtifacts: true,
                        projectName: project,
                        selector: selector,
                    )
                }
                // Run as the Jenkins user so rattler-build's 0600 output is
                // host-readable; the package cache is ${HOME}/conda_pkgs_cache
                // on the agent, shared with the root pipeline's Conda
                // packages stage (see conda-builder/verify_packages.sh for the
                // mounts).
                sh '''
                    docker build -f conda-builder/Dockerfile \
                        -t ${CONDA_BUILDER_TAG} conda-builder
                    mkdir -p "${HOME}/conda_pkgs_cache"
                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -e MAMBA_ROOT_PREFIX=/tmp/mamba \
                        -v "${HOME}/conda_pkgs_cache":/tmp/mamba/pkgs \
                        -v "$PWD":"$PWD" \
                        -w "$PWD" \
                        ${CONDA_BUILDER_TAG} \
                        bash conda-builder/annotator_package.sh vep_annotator
                '''
            }
            post {
                success {
                    archiveArtifacts(
                        artifacts: 'conda/vep_annotator/noarch/*.conda',
                        fingerprint: true,
                    )
                }
            }
        }
    }

    post {
        always {
            script {
                junit(
                    allowEmptyResults: true,
                    testResults: 'reports/integration/*.xml',
                )
                archiveArtifacts(
                    artifacts: 'reports/integration/*.xml',
                    allowEmptyArchive: true,
                    fingerprint: false,
                )
            }
        }
        // `always` above must run before these so the test-result action
        // zulipAlert() reads is already attached to the build.
        failure {
            // Wrapped in an explicit node block: a pipeline-init failure can
            // tear down the outer agent before post runs, leaving zulipSend
            // without a FilePath context. `builder` rather than this job's
            // own `pooh` pin — posting a message needs no VEP cache.
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('FAILED', '❌'),
                )
            }
        }
        unstable {
            node('builder') {
                zulipSend(
                    topic: "${env.JOB_NAME}",
                    message: zulipAlert('UNSTABLE', '⚠️'),
                )
            }
        }
        cleanup {
            sh 'docker rmi ${IMAGE_TAG} ${CONDA_BUILDER_TAG} 2>/dev/null || true'
        }
    }
}
